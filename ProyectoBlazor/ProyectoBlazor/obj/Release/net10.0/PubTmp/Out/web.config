      <aspNetCore processPath="dotnet" arguments=".\ProyectoBlazor.dll" stdoutLogEnabled="false" stdoutLogFile="\\?\%home%\LogFiles\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
