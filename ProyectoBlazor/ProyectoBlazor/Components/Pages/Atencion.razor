@page "/Atencion"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Atencion</PageTitle>
<!-- ============================================================
     juego Color de Tinta
     ============================================================ -->

<div class="page-scope">
    <div class="background-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <nav class="game-nav">
        <NavLink href="Estudiante">← Volver a tus pruebas</NavLink>
        <NavLink href="" Match="NavLinkMatch.All">Volver a inicio</NavLink>
    </nav>

    <main class="game-wrapper">
        <!-- Instrucciones previas a cada fase -->
        <div id="phase-card" class="glass-card phase-card hidden">
            <span id="phase-kicker" class="phase-kicker">Fase 1 de 3</span>
            <h2 id="phase-title" class="phase-title">Color de la tinta</h2>
            <p id="phase-desc" class="phase-desc"></p>
            <div id="phase-example" class="phase-example" aria-label="Ejemplo"></div>
            <p id="phase-meta" class="phase-meta"></p>
            <button id="btn-start-phase" class="btn-primary" type="button">Comenzar fase</button>
        </div>

        <!-- Pantalla de juego -->
        <div id="game-card" class="glass-card">
            <header class="game-header">
                <div class="header-top">
                    <div class="badge-tag">
                        <span class="pulse-dot"></span>
                        Test de Control Cognitivo
                    </div>
                    <button id="btn-sound-toggle" class="icon-btn" aria-label="Activar o desactivar sonido" title="Sonido activado/desactivado">
                        <svg id="sound-icon-on" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                        </svg>
                        <svg id="sound-icon-off" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                            <line x1="23" y1="9" x2="17" y2="15"></line>
                            <line x1="17" y1="9" x2="23" y2="15"></line>
                        </svg>
                    </button>
                </div>

                <h1 class="game-title">Desafío de Atención</h1>

                <div class="instruction-banner">
                    <span class="banner-icon">🎯</span>
                    <p id="instruction-text"></p>
                </div>

                <!-- Barra de métricas -->
                <div class="stats-panel">
                    <div class="stat-pill round-pill">
                        <span id="position-indicator" class="stat-value">Fase 1/3 · Nivel 1/5</span>
                    </div>

                    <div class="scores-group">
                        <div class="stat-pill hit-pill" title="Aciertos acumulados">
                            <span class="stat-icon">✓</span>
                            <span class="stat-label">Aciertos:</span>
                            <span id="hits-count" class="stat-value">0</span>
                        </div>
                        <div class="stat-pill miss-pill" title="Errores acumulados">
                            <span class="stat-icon">✗</span>
                            <span class="stat-label">Errores:</span>
                            <span id="misses-count" class="stat-value">0/5</span>
                        </div>
                    </div>

                    <div class="progress-bar-container">
                        <div id="progress-bar" class="progress-bar-fill"></div>
                    </div>
                </div>
            </header>

            <!-- Área de la palabra central (Estímulo Stroop) -->
            <section class="stimulus-section" aria-live="polite">
                <div class="stimulus-box" id="stimulus-box">
                    <span id="task-label" class="task-label task-tinta">TINTA</span>
                    <span id="stimulus-hint" class="stimulus-hint">¿De qué color es la tinta?</span>
                    <div id="stimulus-word" class="stimulus-word">CARGANDO...</div>
                </div>
                <div id="feedback-toast" class="feedback-toast hidden"></div>
            </section>

            <!-- Cuadrícula de 4 a 6 opciones -->
            <section class="options-section">
                <p id="options-hint" class="options-hint">Elige una opción:</p>
                <div id="options-grid" class="options-grid" role="group" aria-label="Opciones de colores">
                    <!-- Botones inyectados dinámicamente por JavaScript -->
                </div>
            </section>
        </div>

        <!-- Pantalla de Resultados Finales -->
        <div id="results-card" class="glass-card hidden">
            <div class="results-header">
                <div class="trophy-badge" id="results-icon">🏆</div>
                <h2 class="results-title">¡Prueba Finalizada!</h2>
                <p id="results-subtitle" class="results-subtitle">Resumen de tu prueba de atención.</p>
            </div>

            <!-- Resumen de Estadísticas -->
            <div class="summary-cards-grid">
                <div class="summary-card hits-summary">
                    <span class="summary-num" id="final-hits">0</span>
                    <span class="summary-label">Aciertos</span>
                </div>
                <div class="summary-card misses-summary">
                    <span class="summary-num" id="final-misses">0</span>
                    <span class="summary-label">Errores</span>
                </div>
                <div class="summary-card accuracy-summary">
                    <span class="summary-num" id="final-accuracy">0%</span>
                    <span class="summary-label">Precisión</span>
                </div>
                <div class="summary-card score-summary">
                    <span class="summary-num" id="final-score">0</span>
                    <span class="summary-label">Puntaje /100</span>
                </div>
            </div>

            <!-- Diagnóstico de rendimiento -->
            <div class="evaluation-box" id="evaluation-box">
                <h3 id="evaluation-title">Evaluación de Enfoque</h3>
                <p id="evaluation-desc">Calculando...</p>
            </div>

            <!-- Desglose por fase -->
            <div class="breakdown-wrapper">
                <h3 class="breakdown-heading">Detalle por fase</h3>
                <div id="phases-breakdown" class="phases-breakdown">
                    <!-- Rellenado por app.js -->
                </div>
            </div>

            <div class="results-actions">
                <NavLink id="btn-return-home" href="Estudiante" class="btn-primary" style="text-decoration:none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    Regresar al Inicio
                </NavLink>
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <p>Basado en el <strong>Efecto Stroop</strong> (1935) — Paradigma clásico de psicología cognitiva y atención selectiva.</p>
    </footer>

    <!-- Pantalla de Inicio / Instrucciones -->
    <div class="start-screen" id="startScreen">
        <div class="cover-wrap">
            <header class="cover-header">
                <div class="header__badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="3" /></svg>
                    Atención
                </div>
                <h1 class="header__title">Desafío de Atención</h1>
                <p class="header__subtitle">Tres fases para medir tu control de la atención: tinta, palabra y mixta</p>
            </header>
            <div class="start-card">
                <div class="start-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                </div>
                <h2>¿Listo para el reto?</h2>
                <p>Pon a prueba tu control cognitivo con el clásico Efecto Stroop. Verás nombres de colores escritos con una tinta diferente y, según la fase, responderás por el color de la tinta, por lo que dice la palabra o por lo que te pida la etiqueta.</p>
                <div class="cover-rules">
                    <div class="cover-rules__item"><span class="cover-rules__num">1</span> 3 fases: color de la tinta, lee la palabra y mixta</div>
                    <div class="cover-rules__item"><span class="cover-rules__num">2</span> 5 niveles por fase, cada vez con más opciones (hasta 6)</div>
                    <div class="cover-rules__item"><span class="cover-rules__num">3</span> Al acumular 5 errores en total, la prueba se cierra</div>
                </div>
                <button class="btn-primary-cover" id="btnStartGame" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                    Iniciar Prueba
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("iniciarAtencion");
        }
    }
}
