    </div>

    <h2>@(EsRegistro ? "Crear cuenta" : "Bienvenido")</h2>
    <p class="subtitle">@(EsRegistro ? "Llena tus datos para registrarte" : "Ingresa tus credenciales para continuar")</p>

    @* Perfil: si viene de Home (?rol=...) se muestra la etiqueta; si no, se elige aquí *@
    @if (EsDocente || EsEstudiante)
    {
        if (!string.IsNullOrWhiteSpace(RolQuery))
        {
            <div class="role-badge"><span>@(EsDocente ? "Docente" : "Estudiante")</span></div>
        }
        else
        {
            <div class="role-pick">
                <button type="button" class="@(EsEstudiante ? "activa" : "")" @onclick="@(() => ElegirRol("Estudiantes"))">Estudiante</button>
                <button type="button" class="@(EsDocente ? "activa" : "")" @onclick="@(() => ElegirRol("Docente"))">Docente</button>
            </div>
        }
    }
    else
    {
        <div class="role-pick">
            <button type="button" @onclick="@(() => ElegirRol("Estudiantes"))">Estudiante</button>
            <button type="button" @onclick="@(() => ElegirRol("Docente"))">Docente</button>
        </div>
    }

    <div class="tabs">
        <button type="button" class="@(EsRegistro ? "" : "activa")" @onclick="@(() => CambiarModo(false))">Iniciar sesión</button>
        <button type="button" class="@(EsRegistro ? "activa" : "")" @onclick="@(() => CambiarModo(true))">Crear cuenta</button>
    </div>

    <form @onsubmit="Enviar">

        @if (EsRegistro)
        {
            <div class="field">
                <label for="nombre">Nombre completo</label>
                <input id="nombre" type="text" @bind="Nombre" @bind:event="oninput" placeholder="Ej. Joshua Ruiz López" autocomplete="name" />
            </div>

            if (!EsDocente)
            {
                <div class="field">
                    <label for="control">Número de control</label>
                    <input id="control" type="text" @bind="NumeroControl" @bind:event="oninput" placeholder="Ej. 21212363" />
                </div>
            }
        }

        <div class="field">
            <label for="correo">Correo electrónico</label>
            <input id="correo" type="email" @bind="Correo" @bind:event="oninput" placeholder="ejemplo@tectijuana.edu.mx" autocomplete="email" />
        </div>

        <div class="field">
            <label for="password">Contraseña</label>
            <input id="password" type="password" @bind="Password" @bind:event="oninput" placeholder="••••••••" autocomplete="@(EsRegistro ? "new-password" : "current-password")" />
        </div>

        @if (EsRegistro)
        {
            <div class="field">
                <label for="confirmar">Confirmar contraseña</label>
                <input id="confirmar" type="password" @bind="Confirmar" @bind:event="oninput" placeholder="••••••••" autocomplete="new-password" />
                <p class="ayuda">Mínimo 6 caracteres.</p>
            </div>

            if (EsDocente)
            {
                <div class="field">
                    <label for="claveDocente">Clave de docente</label>
                    <input id="claveDocente" type="password" @bind="ClaveDocente" @bind:event="oninput" placeholder="Clave que te dio el departamento" autocomplete="off" />
                    <p class="ayuda">Solo el personal docente puede registrarse. Pide la clave al Departamento de Sistemas y Computación.</p>
                </div>
            }
            else
            {
                <div class="field">
                    <label for="grupo">Código de grupo (opcional)</label>
                    <input id="grupo" type="text" @bind="CodigoGrupo" @bind:event="oninput" placeholder="Ej. INF-2026-A" maxlength="20" />
                    <p class="ayuda">Si tu docente ya te dio un código, escríbelo para que tus resultados aparezcan en su panel.</p>
                </div>
            }
        }

        <button id="btn-login" type="submit" class="btn-login" disabled="@Procesando">
            @(Procesando ? "Un momento..." : (EsRegistro ? "Crear cuenta" : "Ingresar"))
        </button>
    </form>

    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <div class="form-error">@MensajeError</div>
    }

    <p class="cambiar">
        @if (EsRegistro)
        {
            <span>¿Ya tienes cuenta? <button type="button" @onclick="@(() => CambiarModo(false))">Inicia sesión</button></span>
        }
        else
        {
            <span>¿Aún no tienes cuenta? <button type="button" @onclick="@(() => CambiarModo(true))">Regístrate</button></span>
        }
    </p>

    <NavLink class="volver" href="" Match="NavLinkMatch.All">← Regresar al inicio</NavLink>
  </div>
</main>

<footer>
  Instituto Tecnológico de Tijuana · Departamento de Sistemas y Computación
</footer>
</div>

@code {
    // ───────── Perfil (viene de Home: ?rol=Estudiantes o ?rol=Docente) ─────────
    [SupplyParameterFromQuery(Name = "rol")]
    public string? RolQuery { get; set; }

    private string RolSeleccionado { get; set; } = "";
    private string RolActivo => !string.IsNullOrWhiteSpace(RolQuery) ? RolQuery : RolSeleccionado;

    private bool EsDocente => string.Equals(RolActivo, "Docente", StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(RolActivo, "Docentes", StringComparison.OrdinalIgnoreCase);
    private bool EsEstudiante => string.Equals(RolActivo, "Estudiantes", StringComparison.OrdinalIgnoreCase) ||
                                 string.Equals(RolActivo, "Estudiante", StringComparison.OrdinalIgnoreCase);

    // ───────── Campos del formulario ─────────
    private string Correo { get; set; } = "";
    private string Password { get; set; } = "";
    private string Nombre { get; set; } = "";         // solo registro
    private string NumeroControl { get; set; } = "";  // solo registro (estudiante)
    private string Confirmar { get; set; } = "";      // solo registro
    private string CodigoGrupo { get; set; } = "";    // solo registro (estudiante, opcional)
    private string ClaveDocente { get; set; } = "";   // solo registro (docente)
    private string MensajeError { get; set; } = "";

    private bool EsRegistro { get; set; } = false;    // false = iniciar sesión, true = crear cuenta
    private bool Procesando { get; set; } = false;

    private void ElegirRol(string rol)
    {
        RolSeleccionado = rol;
        MensajeError = "";
    }

    private void CambiarModo(bool registro)
    {
        EsRegistro = registro;
        MensajeError = "";
    }

    // ───────── Envío del formulario ─────────
    private async Task Enviar()
    {
        MensajeError = "";

        if (!EsDocente && !EsEstudiante)
        {
            MensajeError = "Por favor selecciona si eres Estudiante o Docente para continuar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Correo) || string.IsNullOrWhiteSpace(Password))
        {
            MensajeError = "Por favor ingresa tu correo y contraseña.";
            return;
        }

        if (EsRegistro)
        {
            if (string.IsNullOrWhiteSpace(Nombre))
            {
                MensajeError = "Por favor escribe tu nombre completo.";
                return;
            }
            if (EsEstudiante && string.IsNullOrWhiteSpace(NumeroControl))
            {
                MensajeError = "Por favor escribe tu número de control.";
                return;
            }
            if (EsDocente && string.IsNullOrWhiteSpace(ClaveDocente))
            {
                MensajeError = "Por favor escribe la clave de docente.";
                return;
            }
            if (Password != Confirmar)
            {
                MensajeError = "Las contraseñas no coinciden.";
                return;
            }
        }

        Procesando = true;
        try
        {
            string? error = EsRegistro ? await RegistrarAsync() : await EntrarAsync();
            if (error != null)
            {
                MensajeError = error;
                return;
            }

            Navigation.NavigateTo(EsDocente ? "/Docente" : "/Estudiante", forceLoad: true);
        }
        catch (Exception)
        {
            MensajeError = "Ocurrió un error. Intenta de nuevo.";
        }
        finally
        {
            Procesando = false;
        }
    }

    // ============================================================
    //  BASE DE DATOS  —  lo único que hay que reemplazar
    // ============================================================
    // Las dos funciones devuelven null si todo salió bien, o el mensaje de error.
    //
    //  RegistrarAsync(): crear la cuenta.
    //      Estudiante: Nombre, NumeroControl, Correo, Password, CodigoGrupo (opcional)
    //      Docente:    Nombre, Correo, Password, ClaveDocente (obligatoria)
    //  EntrarAsync():    validar Correo + Password del perfil activo.
    //
    // Al terminar bien se debe llamar a AbrirSesionAsync(...) para que las páginas
    // Estudiante / Docente / juegos sepan quién entró (ver al final).
    // La contraseña NUNCA se guarda en texto plano: aquí se guarda con PBKDF2.

    private async Task<string?> RegistrarAsync()
    {
        var rol = EsDocente ? "docente" : "estudiante";
        var correo = Correo.Trim().ToLowerInvariant();
        var nombreCompleto = string.Join(' ', Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries));
        var control = NumeroControl.Trim();
        var codigo = CodigoGrupo.Trim().ToUpperInvariant();

        // Solo el personal docente puede crear una cuenta de docente.
        if (EsDocente && !string.Equals(ClaveDocente.Trim(), ClaveDocenteValida, StringComparison.Ordinal))
            return "La clave de docente no es correcta.";

        if (nombreCompleto.Length < 3) return "Escribe tu nombre completo.";
        if (!CorreoValido(correo)) return "Escribe un correo válido.";
        if (Password.Length < 6) return "La contraseña debe tener al menos 6 caracteres.";
        if (EsEstudiante)
        {
            if (control.Length < 6 || control.Length > 20 || !control.All(char.IsLetterOrDigit))
                return "Escribe tu número de control (de 6 a 20 letras o números).";
            if (codigo.Length > 0 && (codigo.Length < 4 || codigo.Length > 20 || !codigo.All(c => char.IsLetterOrDigit(c) || c == '-')))
                return "El código de grupo no es válido.";
        }

        var (nombre, paterno, materno) = SepararNombreCompleto(nombreCompleto);
        var sal = NuevaSal();
        var hashConSal = $"{sal}:{CalcularHash(Password, sal)}";

        if (EsDocente)
        {
            if (await Db.Docentes.AnyAsync(d => d.CorreoElectronico.ToLower() == correo))
                return "Ya existe una cuenta de docente con ese correo. Inicia sesión.";

            string numEmpleado;
            do
            {
                numEmpleado = "D-" + RandomNumberGenerator.GetInt32(1000, 99999);
            } while (await Db.Docentes.AnyAsync(d => d.NumeroEmpleado == numEmpleado));

            var nuevoDocente = new ProyectoBlazor.Models.Docente
            {
                Nombre = nombre,
                ApellidoPaterno = paterno,
                ApellidoMaterno = materno,
                NumeroEmpleado = numEmpleado,
                Carrera = "Ingeniería en Sistemas Computacionales",
                CorreoElectronico = correo,
                Contrasena = hashConSal,
                FechaRegistro = DateTime.Now
            };

            Db.Docentes.Add(nuevoDocente);
            await Db.SaveChangesAsync();

            var usuario = new Usuario
            {
                Id = nuevoDocente.IdDocente,
                Rol = rol,
                Nombre = nombreCompleto,
                Correo = correo
            };
            await AbrirSesionAsync(usuario, null);
            return null;
        }
        else
        {
            if (await Db.Estudiantes.AnyAsync(e => e.CorreoElectronico.ToLower() == correo))
                return "Ya existe una cuenta con ese correo. Inicia sesión.";
            if (await Db.Estudiantes.AnyAsync(e => e.Matricula.ToLower() == control.ToLower()))
                return "Ya existe una cuenta con ese número de control.";

            ProyectoBlazor.Models.Grupo? grupoBd = null;
            if (codigo.Length > 0)
            {
                grupoBd = await Db.Grupos.FirstOrDefaultAsync(g => g.CodigoGrupo.ToUpper() == codigo && g.Activo);
                if (grupoBd == null)
                    return "No se encontró ningún grupo activo con ese código.";
            }

            var nuevoEstudiante = new ProyectoBlazor.Models.Estudiante
            {
                Nombre = nombre,
                ApellidoPaterno = paterno,
                ApellidoMaterno = materno,
                Matricula = control,
                Carrera = "Ingeniería en Sistemas Computacionales",
                CorreoElectronico = correo,
                Contrasena = hashConSal,
                FechaRegistro = DateTime.Now
            };

            Db.Estudiantes.Add(nuevoEstudiante);
            await Db.SaveChangesAsync();

            if (grupoBd != null)
            {
                Db.GruposEstudiantes.Add(new ProyectoBlazor.Models.GrupoEstudiante
                {
                    IdGrupo = grupoBd.IdGrupo,
                    IdEstudiante = nuevoEstudiante.IdEstudiante,
                    FechaInscripcion = DateTime.Now
                });
                await Db.SaveChangesAsync();
            }

            var usuario = new Usuario
            {
                Id = nuevoEstudiante.IdEstudiante,
                Rol = rol,
                Nombre = nombreCompleto,
                Correo = correo,
                NumeroControl = control,
                EstudianteId = nuevoEstudiante.IdEstudiante
            };
            await AbrirSesionAsync(usuario, grupoBd?.CodigoGrupo);
            return null;
        }
    }

    private async Task<string?> EntrarAsync()
    {
        var rol = EsDocente ? "docente" : "estudiante";
        var correo = Correo.Trim().ToLowerInvariant();

        if (EsDocente)
        {
            var docente = await Db.Docentes.FirstOrDefaultAsync(d => d.CorreoElectronico.ToLower() == correo);
            if (docente == null)
                return "No encontramos una cuenta de docente con ese correo. Usa \"Crear cuenta\".";

            if (!VerificarContrasena(Password, docente.Contrasena))
                return "La contraseña es incorrecta.";

            var nombreCompleto = FormatearNombreCompleto(docente.Nombre, docente.ApellidoPaterno, docente.ApellidoMaterno);
            var usuario = new Usuario
            {
                Id = docente.IdDocente,
                Rol = rol,
                Nombre = nombreCompleto,
                Correo = docente.CorreoElectronico
            };

            var grupoDocente = await Db.Grupos
                .Where(g => g.IdDocente == docente.IdDocente && g.Activo)
                .OrderByDescending(g => g.FechaCreacion)
                .FirstOrDefaultAsync();

            await AbrirSesionAsync(usuario, grupoDocente?.CodigoGrupo);
            return null;
        }
        else
        {
            var estudiante = await Db.Estudiantes.FirstOrDefaultAsync(e => e.CorreoElectronico.ToLower() == correo);
            if (estudiante == null)
                return "No encontramos una cuenta de estudiante con ese correo. Usa \"Crear cuenta\".";

            if (!VerificarContrasena(Password, estudiante.Contrasena))
                return "La contraseña es incorrecta.";

            var inscripcion = await Db.GruposEstudiantes
                .Include(ge => ge.Grupo)
                .Where(ge => ge.IdEstudiante == estudiante.IdEstudiante)
                .OrderByDescending(ge => ge.FechaInscripcion)
                .FirstOrDefaultAsync();

            var codigoGrupo = inscripcion?.Grupo?.CodigoGrupo;
            var nombreCompleto = FormatearNombreCompleto(estudiante.Nombre, estudiante.ApellidoPaterno, estudiante.ApellidoMaterno);

            var usuario = new Usuario
            {
                Id = estudiante.IdEstudiante,
                Rol = rol,
                Nombre = nombreCompleto,
                Correo = estudiante.CorreoElectronico,
                NumeroControl = estudiante.Matricula,
                EstudianteId = estudiante.IdEstudiante
            };

            await AbrirSesionAsync(usuario, codigoGrupo);
            return null;
        }
    }

    private static (string Nombre, string Paterno, string? Materno) SepararNombreCompleto(string nombreCompleto)
    {
        var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1)
            return (partes[0], "-", null);
        if (partes.Length == 2)
            return (partes[0], partes[1], null);
        var materno = partes[^1];
        var paterno = partes[^2];
        var nombres = string.Join(' ', partes[..^2]);
        return (nombres, paterno, materno);
    }

    private static string FormatearNombreCompleto(string nombre, string paterno, string? materno)
    {
        var partes = new List<string> { nombre };
        if (!string.IsNullOrWhiteSpace(paterno) && paterno != "-") partes.Add(paterno);
        if (!string.IsNullOrWhiteSpace(materno)) partes.Add(materno);
        return string.Join(' ', partes);
    }

    private static bool VerificarContrasena(string passwordIngresado, string contrasenaGuardada)
    {
        if (contrasenaGuardada.Contains(':'))
        {
            var partes = contrasenaGuardada.Split(':', 2);
            try
            {
                var esperado = Convert.FromBase64String(partes[1]);
                var calculado = Convert.FromBase64String(CalcularHash(passwordIngresado, partes[0]));
                return CryptographicOperations.FixedTimeEquals(esperado, calculado);
            }
            catch
            {
                return false;
            }
        }
        return string.Equals(passwordIngresado, contrasenaGuardada, StringComparison.Ordinal);
    }

    private const string ClaveDocenteValida = "TECTIJ-DOCENTE";

    public class Usuario
    {
        public int Id { get; set; }
        public string Rol { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Correo { get; set; } = "";
        public string? NumeroControl { get; set; }
        public int? EstudianteId { get; set; }
    }

    private static bool CorreoValido(string correo)
    {
        var partes = correo.Split('@');
        return partes.Length == 2 && partes[0].Length > 0 && partes[1].Contains('.') && !correo.Contains(' ');
    }

    private static string NuevaSal() => Convert.ToBase64String(RandomNumberGenerator.GetBytes(16));

    private static string CalcularHash(string password, string sal)
    {
        var bytes = Rfc2898DeriveBytes.Pbkdf2(password, Convert.FromBase64String(sal), 100_000, HashAlgorithmName.SHA256, 32);
        return Convert.ToBase64String(bytes);
    }

    // Guarda el identificador de sesión actual para que las páginas Estudiante / Docente / juegos sepan quién entró.
    private async Task AbrirSesionAsync(Usuario usuario, string? codigoGrupo)
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "usuariosEvaluacionBlazor");
        await JS.InvokeVoidAsync("localStorage.removeItem", "evaluacionCognitiva");

        if (usuario.Rol == "estudiante")
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "estudianteId", usuario.EstudianteId.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", "estudianteNombre", usuario.Nombre);
            if (!string.IsNullOrWhiteSpace(codigoGrupo)) await JS.InvokeVoidAsync("localStorage.setItem", "grupoCodigo", codigoGrupo);
            else await JS.InvokeVoidAsync("localStorage.removeItem", "grupoCodigo");
            await JS.InvokeVoidAsync("localStorage.removeItem", "docenteId");
            await JS.InvokeVoidAsync("localStorage.removeItem", "docenteNombre");
            await JS.InvokeVoidAsync("localStorage.removeItem", "docenteCorreo");
        }
        else
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "docenteId", usuario.Id.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", "docenteNombre", usuario.Nombre);
            await JS.InvokeVoidAsync("localStorage.setItem", "docenteCorreo", usuario.Correo);
            if (!string.IsNullOrWhiteSpace(codigoGrupo))
                await JS.InvokeVoidAsync("localStorage.setItem", "grupoDocenteCodigo", codigoGrupo);
            await JS.InvokeVoidAsync("localStorage.removeItem", "estudianteId");
            await JS.InvokeVoidAsync("localStorage.removeItem", "estudianteNombre");
            await JS.InvokeVoidAsync("localStorage.removeItem", "grupoCodigo");
        }
    }
}
