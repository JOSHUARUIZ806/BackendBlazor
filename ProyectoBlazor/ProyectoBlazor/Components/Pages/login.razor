@page "/login"
@inject NavigationManager Navigation

@* CAMBIO: Título de la pestaña del navegador *@
<PageTitle>Login</PageTitle>

@* ORIGINAL (se conserva comentado para referencia histórica del proyecto):
<h3>Página de Login cargada correctamente</h3>
*@

@* CAMBIO: Estilos propios del login, manteniendo la misma estructura y paleta de colores institucional *@
<style>
  .login-wrap{ min-height:100vh; display:flex; align-items:center; justify-content:center;
               background:#F6F7F8; font-family:'Inter', sans-serif; padding:24px; }
  .login-card{ background:#fff; border:1px solid #ECEDEF; border-radius:12px; padding:40px 32px;
               width:100%; max-width:380px; box-shadow:0 8px 20px rgba(26,53,96,0.08); }
  .login-card h2{ color:#1A3560; font-size:22px; margin-bottom:4px; text-align:center; font-weight:700; }
  .login-card .sub{ color:#C97B2E; font-size:14px; text-align:center; margin-bottom:24px; font-weight:500; }
  .login-card label{ display:block; font-size:13px; color:#1F2937; margin:14px 0 6px; font-weight:500; }
  .login-card input, .login-card select{
      width:100%; padding:10px 12px; border:1px solid #D1D5DB; border-radius:8px;
      font-size:14px; font-family:'Inter', sans-serif; background:#fff; color:#1F2937;
      box-sizing:border-box;
  }
  .login-card input:focus, .login-card select:focus{ outline:none; border-color:#1A3560; }
  .btn-login{ width:100%; margin-top:22px; padding:11px; background:#1A3560; color:#fff; border:none;
              border-radius:8px; font-size:15px; font-weight:600; cursor:pointer; transition:background .15s ease; }
  .btn-login:hover{ background:#132848; }
  .error{ color:#B91C1C; font-size:13px; margin-top:12px; text-align:center; }
  .volver{ display:block; text-align:center; margin-top:16px; font-size:13px; color:#6B7280; text-decoration:none; }
  .volver:hover{ color:#1A3560; }
</style>

<div class="login-wrap">
  <div class="login-card">
    <h2>Iniciar sesión</h2>

    @* CAMBIO: Indicador del rol definido.
       Si el rol ya fue definido en la navegación desde Home (?rol=Estudiantes o ?rol=Docente),
       se muestra claramente al usuario.
       Si se ingresó directo a /login sin parámetro de rol, se despliega un selector
       para que el usuario elija su perfil sin perder la estructura ni el diseño. *@
    @if (!string.IsNullOrEmpty(RolQuery))
    {
        <p class="sub">Ingresando como: @(EsDocente ? "Docente" : "Estudiante")</p>
    }
    else
    {
        <p class="sub">Acceso general al sistema</p>
        <label for="rolSelect">Perfil de usuario</label>
        <select id="rolSelect" @bind="RolSeleccionado">
            <option value="">-- Selecciona tu rol --</option>
            <option value="Estudiantes">Estudiante</option>
            <option value="Docente">Docente</option>
        </select>
    }

    @* CAMBIO: Formulario 100% genérico.
       Se eliminaron las diferencias previas donde a estudiante se le pedía grupo y a docente contraseña.
       Ahora ambos perfiles utilizan los mismos campos estándar: Correo electrónico y Contraseña. *@
    <label for="correo">Correo electrónico</label>
    <input id="correo" type="email" @bind="Correo" placeholder="ejemplo@tectijuana.edu.mx" />

    <label for="password">Contraseña</label>
    <input id="password" type="password" @bind="Password" placeholder="••••••••" />

    <button id="btn-login" class="btn-login" @onclick="IniciarSesion">Entrar</button>

    @if (!string.IsNullOrEmpty(MensajeError))
    {
        <p class="error">@MensajeError</p>
    }

    @* CAMBIO: NavLink para regresar al Home si el usuario desea cambiar de perfil *@
    <NavLink class="volver" href="">← Regresar al inicio</NavLink>
  </div>
</div>

@code {
    // CAMBIO: Recibe el parámetro de rol definido desde la URL (?rol=Estudiantes o ?rol=Docente)
    [SupplyParameterFromQuery(Name = "rol")]
    public string? RolQuery { get; set; }

    // CAMBIO: Variable para almacenar el rol en caso de seleccionarlo directamente en la vista
    private string RolSeleccionado { get; set; } = "";

    // CAMBIO: Campos genéricos del formulario para cualquier usuario
    private string Correo { get; set; } = "";
    private string Password { get; set; } = "";
    private string MensajeError { get; set; } = "";

    // CAMBIO: Determina el rol activo considerando primero el parámetro de URL y luego el selector
    private string RolActivo => !string.IsNullOrWhiteSpace(RolQuery) ? RolQuery : RolSeleccionado;

    // CAMBIO: Propiedad auxiliar para saber si es docente
    private bool EsDocente => string.Equals(RolActivo, "Docente", StringComparison.OrdinalIgnoreCase) ||
                              string.Equals(RolActivo, "Docentes", StringComparison.OrdinalIgnoreCase);

    // CAMBIO: Se sincroniza el rol seleccionado cuando se establecen los parámetros del componente
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(RolQuery))
        {
            RolSeleccionado = RolQuery;
        }
    }

    // CAMBIO: Método único de inicio de sesión que valida los campos genéricos
    // y redirige hacia la vista correspondiente según el rol definido para el usuario.
    private void IniciarSesion()
    {
        // CAMBIO: Validación genérica de campos obligatorios
        if (string.IsNullOrWhiteSpace(Correo) || string.IsNullOrWhiteSpace(Password))
        {
            MensajeError = "Por favor ingresa tu correo y contraseña.";
            return;
        }

        // CAMBIO: Redirección condicional basada en el rol definido
        if (string.Equals(RolActivo, "Estudiantes", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(RolActivo, "Estudiante", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/Estudiante");
        }
        else if (EsDocente)
        {
            Navigation.NavigateTo("/Docente");
        }
        else
        {
            // CAMBIO: Mensaje amigable si no se ha definido ningún rol
            MensajeError = "Por favor selecciona si eres Estudiante o Docente para continuar.";
        }
    }
}