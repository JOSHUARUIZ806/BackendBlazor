@page "/Razonamiento"
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Razonamiento</PageTitle>
<!-- ============================================================
     juego Sucesión logicas
     ============================================================ -->

<div class="page-scope">
    <nav class="game-nav">
        <NavLink href="Estudiante">← Volver a tus pruebas</NavLink>
        <NavLink href="" Match="NavLinkMatch.All">Volver a inicio</NavLink>
    </nav>

    <div class="app">
        <!-- HEADER -->
        <header class="header">
            <div class="header__badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                </svg>
                Razonamiento Lógico
            </div>
            <h1 class="header__title">Sucesiones Lógicas</h1>
            <p class="header__subtitle">Descubre el patrón oculto y encuentra el elemento que falta</p>
        </header>

        <!-- SCREEN: START -->
        <section id="screen-start" class="screen active">
            <div class="start-card">
                <div class="start-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <polygon points="5 3 19 12 5 21 5 3" />
                    </svg>
                </div>
                <h2>¿Listo para el reto?</h2>
                <p>
                    Resuelve 15 niveles divididos en 3 fases de 5 niveles cada una. En cada nivel verás una sucesión con el
                    último elemento oculto: deduce el patrón y elige la opción correcta entre cuatro. Los problemas se generan
                    aleatoriamente.
                </p>
                <div class="rules-list">
                    <div class="rules-list__item">
                        <span class="rules-list__num">1</span>Fase 1 (Niveles 1–5) · Números: sumas,
                        diferencias crecientes, operaciones alternadas y series entrelazadas
                    </div>
                    <div class="rules-list__item">
                        <span class="rules-list__num">2</span>Fase 2 (Niveles 6–10) · Letras: saltos en
                        el alfabeto español
                    </div>
                    <div class="rules-list__item">
                        <span class="rules-list__num">3</span>Fase 3 (Niveles 11–15) · Flechas: giros de
                        90° y patrones de relleno
                    </div>
                </div>
                <button id="btn-start" class="btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                         stroke-linejoin="round">
                        <polygon points="5 3 19 12 5 21 5 3" />
                    </svg>
                    Iniciar Prueba
                </button>
            </div>
        </section>

        <!-- SCREEN: INICIO DE FASE -->
        <section id="screen-level" class="screen">
            <div class="level-card">
                <span id="level-badge" class="level-card__badge"></span>
                <h2 id="level-title"></h2>
                <p id="level-desc"></p>
                <div id="level-steps" class="level-steps"></div>
                <button id="btn-level-start" class="btn-primary">
                    Comenzar fase
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                         stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </button>
            </div>
        </section>

        <!-- SCREEN: QUIZ -->
        <section id="screen-quiz" class="screen">
            <!-- Top bar -->
            <div class="quiz-topbar">
                <div class="quiz-progress">
                    <span id="progress-label">Nivel 1 / 15</span>
                    <div class="quiz-progress__bar">
                        <div id="progress-fill" class="quiz-progress__fill" style="width:0%"></div>
                    </div>
                </div>
                <div class="quiz-stats">
                    <div class="quiz-stat quiz-stat--correct">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                             stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span id="stat-correct">0</span>
                    </div>
                    <div class="quiz-stat quiz-stat--wrong">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                             stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                        <span id="stat-wrong">0</span>
                    </div>
                </div>
                <div id="timer" class="quiz-timer">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span id="timer-text">00:00</span>
                </div>
            </div>

            <!-- Question card -->
            <div class="question-card">
                <div id="q-label" class="question-card__label"></div>
                <p id="q-hint" class="question-card__hint"></p>
                <div id="sequence-display" class="sequence-display"></div>
                <div id="explanation" class="explanation" style="display:none">
                    <div class="explanation__title">💡 Explicación</div>
                    <p id="explanation-text" class="explanation__text"></p>
                </div>
            </div>

            <!-- Options -->
            <div id="options-grid" class="options-grid"></div>

            <!-- Next button -->
            <button id="btn-next" class="btn-primary btn-next" style="display:none">
                Siguiente
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                     stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </button>
        </section>

        <!-- SCREEN: RESULTS -->
        <section id="screen-results" class="screen">
            <div class="results-card">
                <div id="results-emoji" class="results-card__emoji"></div>
                <h2 id="results-title"></h2>
                <p id="results-message" class="results-card__message"></p>

                <div class="results-stats">
                    <div class="result-stat">
                        <div id="res-correct" class="result-stat__value result-stat__value--green">0</div>
                        <div class="result-stat__label">Aciertos</div>
                    </div>
                    <div class="result-stat">
                        <div id="res-wrong" class="result-stat__value result-stat__value--red">0</div>
                        <div class="result-stat__label">Errores</div>
                    </div>
                    <div class="result-stat">
                        <div id="res-time" class="result-stat__value result-stat__value--cyan">0s</div>
                        <div class="result-stat__label">Tiempo Total</div>
                    </div>
                </div>

                <div id="results-detail" class="results-detail">
                    <div class="results-detail__title">Desglose por fase</div>
                </div>

                <NavLink id="btn-return-home" href="Estudiante" class="btn-primary"
                   style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    Regresar al Inicio
                </NavLink>
            </div>
        </section>
    </div>

    <!-- Feedback toast -->
    <div id="feedback" class="feedback"></div>

    <!-- Confetti container -->
    <div id="confetti" class="confetti-container"></div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("iniciarRazonamiento");
        }
    }
}
