@page "/Razonamiento"
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Razonamiento</PageTitle>
<!-- ============================================================
     juego Sucesión logicas
     ============================================================ -->

<style>
    /* ===== DESIGN TOKENS ===== */
    :root {
      --bg-base: #FFFFFF;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F6F7F8;
      --bg-surface: #F6F7F8;
      --border-subtle: #ECEDEF;
      --border-accent: rgba(26, 53, 96, .35);

      --text-primary: #1F2937;
      --text-secondary: #6B7280;
      --text-muted: #9CA3AF;

      --accent-indigo: #1A3560;
      --accent-indigo-dim: rgba(26, 53, 96, .08);
      --accent-green: #1E9E63;
      --accent-green-dim: rgba(30, 158, 99, .12);
      --accent-red: #D14343;
      --accent-red-dim: rgba(209, 67, 67, .12);
      --accent-amber: #C97B2E;
      --accent-amber-dim: rgba(201, 123, 46, .12);
      --accent-cyan: #24427A;

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;

      --shadow-card: 0 4px 24px rgba(19, 40, 72, .08);
      --shadow-glow-indigo: 0 0 40px rgba(26, 53, 96, .15);
      --shadow-glow-green: 0 0 30px rgba(30, 158, 99, .18);
      --shadow-glow-red: 0 0 30px rgba(209, 67, 67, .18);

      --transition-fast: .2s cubic-bezier(.4,0,.2,1);
      --transition-normal: .35s cubic-bezier(.4,0,.2,1);
      --transition-slow: .5s cubic-bezier(.4,0,.2,1);
    }

    /* ===== RESET ===== */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ===== BACKGROUND EFFECTS ===== */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 600px 400px at 20% 10%, rgba(26,53,96,.05), transparent),
        radial-gradient(ellipse 500px 350px at 80% 80%, rgba(201,123,46,.04), transparent);
      pointer-events: none;
      z-index: 0;
    }

    /* ===== LAYOUT ===== */
    .app {
      position: relative;
      z-index: 1;
      max-width: 780px;
      margin: 0 auto;
      padding: 4.5rem 1.25rem 4rem;
    }

    /* ===== HEADER ===== */
    .header {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .header__badge {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      background: var(--accent-indigo-dim);
      border: 1px solid var(--border-accent);
      border-radius: 100px;
      padding: .35rem 1rem;
      font-size: .75rem;
      font-weight: 600;
      color: var(--accent-indigo);
      letter-spacing: .04em;
      text-transform: uppercase;
      margin-bottom: .9rem;
    }
    .header__badge svg { width: 14px; height: 14px; }
    .header__title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
      font-weight: 900;
      letter-spacing: -.03em;
      line-height: 1.15;
      background: linear-gradient(135deg, var(--text-primary), var(--accent-indigo));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .header__subtitle {
      color: var(--text-secondary);
      font-size: .95rem;
      margin-top: .5rem;
      line-height: 1.5;
    }

    /* ===== SCREENS ===== */
    .screen { display: none; }
    .screen.active { display: block; animation: fadeSlideIn .45s ease-out; }

    @@keyframes fadeSlideIn {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ===== START SCREEN ===== */
    .start-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem 2rem;
      text-align: center;
      box-shadow: var(--shadow-card);
    }
    .start-card__icon {
      width: 72px; height: 72px;
      margin: 0 auto 1.25rem;
      background: linear-gradient(135deg, #1A3560, #24427A);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-glow-indigo);
    }
    .start-card__icon svg { width: 36px; height: 36px; color: white; }
    .start-card h2 {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: .65rem;
    }
    .start-card p {
      color: var(--text-secondary);
      font-size: .9rem;
      line-height: 1.6;
      max-width: 460px;
      margin: 0 auto 1.5rem;
    }

    .rules-list {
      display: flex;
      flex-direction: column;
      gap: .6rem;
      text-align: left;
      max-width: 420px;
      margin: 0 auto 2rem;
    }
    .rules-list__item {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: .65rem 1rem;
      background: var(--bg-surface);
      border-radius: var(--radius-sm);
      font-size: .85rem;
      color: var(--text-secondary);
    }
    .rules-list__num {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: var(--accent-indigo-dim);
      border: 1px solid var(--border-accent);
      color: var(--accent-indigo);
      font-weight: 700;
      font-size: .75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      background: linear-gradient(135deg, #1A3560, #24427A);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      padding: .85rem 2rem;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all var(--transition-fast);
      box-shadow: 0 4px 20px rgba(26,53,96,.3);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(26,53,96,.4);
    }
    .btn-primary:active { transform: translateY(0); }
    .btn-primary svg { width: 18px; height: 18px; }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      border-radius: var(--radius-md);
      padding: .75rem 1.5rem;
      font-family: inherit;
      font-size: .9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    .btn-secondary:hover {
      background: var(--bg-card-hover);
      border-color: var(--border-accent);
    }

    /* ===== QUIZ SCREEN ===== */
    .quiz-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .quiz-progress {
      display: flex;
      align-items: center;
      gap: .5rem;
      font-size: .8rem;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .quiz-progress__bar {
      width: 120px;
      height: 6px;
      background: var(--bg-surface);
      border-radius: 100px;
      overflow: hidden;
    }
    .quiz-progress__fill {
      height: 100%;
      background: linear-gradient(90deg, #1A3560, #24427A);
      border-radius: 100px;
      transition: width var(--transition-normal);
    }
    .quiz-timer {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: .95rem;
      font-weight: 700;
      color: var(--accent-cyan);
      background: rgba(36,66,122,.08);
      border: 1px solid rgba(36,66,122,.22);
      border-radius: 100px;
      padding: .35rem .9rem;
    }
    .quiz-timer svg { width: 16px; height: 16px; }
    .quiz-timer.warning { color: var(--accent-amber); background: var(--accent-amber-dim); border-color: rgba(251,191,36,.25); }
    .quiz-timer.danger { color: var(--accent-red); background: var(--accent-red-dim); border-color: rgba(248,113,113,.25); animation: pulse 1s infinite; }

    @@keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: .6; }
    }

    .quiz-stats {
      display: flex;
      gap: .75rem;
    }
    .quiz-stat {
      display: flex;
      align-items: center;
      gap: .35rem;
      font-size: .8rem;
      font-weight: 600;
      padding: .3rem .7rem;
      border-radius: 100px;
    }
    .quiz-stat--correct {
      color: var(--accent-green);
      background: var(--accent-green-dim);
    }
    .quiz-stat--wrong {
      color: var(--accent-red);
      background: var(--accent-red-dim);
    }
    .quiz-stat svg { width: 14px; height: 14px; }

    /* ===== QUESTION CARD ===== */
    .question-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2rem;
      box-shadow: var(--shadow-card);
      margin-bottom: 1.5rem;
    }
    .question-card__label {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: .7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: var(--accent-indigo);
      background: var(--accent-indigo-dim);
      border-radius: 100px;
      padding: .25rem .7rem;
      margin-bottom: 1rem;
    }
    .question-card__hint {
      font-size: .85rem;
      color: var(--text-secondary);
      margin-bottom: 1.25rem;
      line-height: 1.5;
      font-style: italic;
    }

    .sequence-display {
      display: flex;
      align-items: center;
      gap: .5rem;
      flex-wrap: wrap;
      justify-content: center;
      padding: 1.25rem;
      background: var(--bg-surface);
      border-radius: var(--radius-md);
      margin-bottom: .5rem;
    }
    .seq-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 700;
      color: var(--text-primary);
      padding: .3rem .6rem;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      min-width: 48px;
      text-align: center;
      animation: popIn .3s ease-out both;
    }
    @@keyframes popIn {
      from { opacity: 0; transform: scale(.7); }
      to { opacity: 1; transform: scale(1); }
    }

    .seq-comma {
      color: var(--text-muted);
      font-size: 1.2rem;
      font-weight: 600;
    }
    .seq-unknown {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 700;
      color: var(--accent-amber);
      padding: .3rem .6rem;
      background: var(--accent-amber-dim);
      border: 2px dashed rgba(201,123,46,.4);
      border-radius: var(--radius-sm);
      min-width: 48px;
      text-align: center;
      animation: popIn .3s ease-out .4s both;
    }

    /* Elementos gráficos de la sucesión (figuras, flechas, relojes) */
    .sequence-display { --item-size: 76px; }
    .seq-item {
      width: var(--item-size);
      height: var(--item-size);
      padding: 6px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      animation: popIn .3s ease-out both;
    }
    .seq-item svg, .option-btn__value svg { display: block; width: 100%; height: 100%; }
    .seq-unknown--grafico {
      width: var(--item-size);
      height: var(--item-size);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }
    .sequence-display--grafico { gap: .6rem; }

    /* ===== OPTIONS ===== */
    .options-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: .75rem;
    }
    .option-btn {
      position: relative;
      display: flex;
      align-items: center;
      gap: .75rem;
      padding: 1rem 1.25rem;
      background: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all var(--transition-fast);
      font-family: inherit;
      text-align: left;
      overflow: hidden;
    }
    .option-btn:hover:not(.disabled) {
      border-color: var(--accent-indigo);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(26,53,96,.12);
    }
    .option-btn__letter {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--bg-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .8rem;
      font-weight: 700;
      color: var(--text-secondary);
      flex-shrink: 0;
      transition: all var(--transition-fast);
    }
    .option-btn:hover:not(.disabled) .option-btn__letter {
      background: var(--accent-indigo-dim);
      color: var(--accent-indigo);
    }
    .option-btn__value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    /* Opciones gráficas: figura grande y centrada junto a la letra */
    .options-grid--grafico .option-btn { justify-content: center; padding: .8rem 1rem; }
    .options-grid--grafico .option-btn__value { width: 84px; height: 84px; }

    /* Option states */
    .option-btn.correct {
      border-color: var(--accent-green);
      background: var(--accent-green-dim);
      pointer-events: none;
    }
    .option-btn.correct .option-btn__letter {
      background: var(--accent-green);
      color: white;
    }
    .option-btn.wrong {
      border-color: var(--accent-red);
      background: var(--accent-red-dim);
      pointer-events: none;
    }
    .option-btn.wrong .option-btn__letter {
      background: var(--accent-red);
      color: white;
    }
    .option-btn.disabled {
      opacity: .45;
      pointer-events: none;
    }

    /* ===== FEEDBACK TOAST ===== */
    .feedback {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(120px);
      padding: 1rem 1.75rem;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: .95rem;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: .6rem;
      transition: transform var(--transition-normal);
      pointer-events: none;
    }
    .feedback.show { transform: translateX(-50%) translateY(0); }
    .feedback--correct {
      background: var(--accent-green);
      color: #ffffff;
      border: none;
      box-shadow: var(--shadow-glow-green);
    }
    .feedback--wrong {
      background: var(--accent-red);
      color: #ffffff;
      border: none;
      box-shadow: var(--shadow-glow-red);
    }
    .feedback svg { width: 20px; height: 20px; }

    /* ===== EXPLANATION PANEL ===== */
    .explanation {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.25rem 1.5rem;
      margin-top: 1.25rem;
      animation: fadeSlideIn .35s ease-out;
    }
    .explanation__title {
      font-size: .75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--accent-amber);
      margin-bottom: .5rem;
    }
    .explanation__text {
      font-size: .88rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .btn-next {
      margin-top: 1.25rem;
      width: 100%;
      justify-content: center;
    }

    /* ===== RESULTS SCREEN ===== */
    .results-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem 2rem;
      text-align: center;
      box-shadow: var(--shadow-card);
    }
    .results-card__emoji {
      font-size: 3.5rem;
      margin-bottom: 1rem;
      animation: bounceIn .5s ease-out;
    }
    @@keyframes bounceIn {
      0% { transform: scale(0); }
      60% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }
    .results-card h2 {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: .5rem;
    }
    .results-card__message {
      color: var(--text-secondary);
      font-size: .9rem;
      margin-bottom: 2rem;
    }

    .results-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: .75rem;
      margin-bottom: 2rem;
    }
    .result-stat {
      background: var(--bg-surface);
      border-radius: var(--radius-md);
      padding: 1.25rem .75rem;
    }
    .result-stat__value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.75rem;
      font-weight: 800;
    }
    .result-stat__value--green { color: var(--accent-green); }
    .result-stat__value--red { color: var(--accent-red); }
    .result-stat__value--cyan { color: var(--accent-cyan); }
    .result-stat__label {
      font-size: .75rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-top: .25rem;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    /* ===== DETAIL TABLE ===== */
    .results-detail {
      text-align: left;
      margin-bottom: 2rem;
    }
    .results-detail__title {
      font-size: .8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--text-muted);
      margin-bottom: .75rem;
    }
    .detail-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .75rem 1rem;
      background: var(--bg-surface);
      border-radius: var(--radius-sm);
      margin-bottom: .5rem;
      font-size: .85rem;
    }
    .detail-row__left {
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .detail-row__icon {
      width: 24px; height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .detail-row__icon--correct { background: var(--accent-green-dim); color: var(--accent-green); }
    .detail-row__icon--wrong { background: var(--accent-red-dim); color: var(--accent-red); }
    .detail-row__icon svg { width: 14px; height: 14px; }
    .detail-row__name { font-weight: 600; color: var(--text-primary); }
    .detail-row__time {
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .detail-row { gap: .75rem; flex-wrap: wrap; }
    .detail-row__name small {
      display: block;
      font-weight: 500;
      font-size: .72rem;
      color: var(--text-muted);
      margin-top: .15rem;
    }
    .detail-row__score {
      font-family: 'JetBrains Mono', monospace;
      font-size: .85rem;
      font-weight: 700;
      color: var(--accent-indigo);
    }

    /* ===== PANTALLA DE INICIO DE NIVEL ===== */
    .level-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem 2rem;
      text-align: center;
      box-shadow: var(--shadow-card);
    }
    .level-card__badge {
      display: inline-block;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--accent-amber);
      background: var(--accent-amber-dim);
      border-radius: 100px;
      padding: .3rem .9rem;
      margin-bottom: 1rem;
    }
    .level-card h2 { font-size: 1.75rem; font-weight: 800; margin-bottom: .6rem; }
    .level-card p {
      color: var(--text-secondary);
      font-size: .92rem;
      line-height: 1.6;
      max-width: 440px;
      margin: 0 auto 1.25rem;
    }
    .level-steps {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: .4rem;
      margin-bottom: 1.75rem;
    }
    .level-steps__chip {
      font-size: .72rem;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 100px;
      padding: .25rem .7rem;
    }
    .level-steps__chip.done { color: var(--accent-green); background: var(--accent-green-dim); border-color: transparent; }
    .level-steps__chip.current { color: #fff; background: var(--accent-indigo); border-color: var(--accent-indigo); }

    /* ===== CONFETTI ===== */
    .confetti-container {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 200;
      overflow: hidden;
    }
    .confetti-piece {
      position: absolute;
      width: 8px;
      height: 14px;
      border-radius: 2px;
      top: -20px;
      animation: confettiFall linear forwards;
    }
    @@keyframes confettiFall {
      0% { transform: translateY(0) rotateZ(0deg); opacity: 1; }
      100% { transform: translateY(110vh) rotateZ(720deg); opacity: 0; }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 500px) {
      .options-grid--texto { grid-template-columns: 1fr; }
      .sequence-display { --item-size: 56px; padding: .75rem; gap: .4rem; }
      .sequence-display--grafico { gap: .4rem; }
      .options-grid--grafico { gap: .5rem; }
      .options-grid--grafico .option-btn { flex-direction: column; gap: .4rem; padding: .7rem .5rem; }
      .options-grid--grafico .option-btn__value { width: 76px; height: 76px; }
      .level-card { padding: 2rem 1.25rem; }
      .results-stats { grid-template-columns: 1fr; }
      .quiz-topbar { flex-direction: column; align-items: flex-start; }
      .question-card { padding: 1.25rem; }
    }
  </style>

<nav class="game-nav">
  <NavLink href="Estudiante">← Volver a tus pruebas</NavLink>
  <NavLink href="" Match="NavLinkMatch.All">Volver a inicio</NavLink>
</nav>

<div class="app">
  <!-- HEADER -->
  <header class="header">
    <div class="header__badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      Razonamiento Lógico
    </div>
    <h1 class="header__title">Sucesiones Lógicas</h1>
    <p class="header__subtitle">Descubre el patrón oculto y encuentra el elemento que falta</p>
  </header>

  <!-- SCREEN: START -->
  <section id="screen-start" class="screen active">
    <div class="start-card">
      <div class="start-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      </div>
      <h2>¿Listo para el reto?</h2>
      <p>Resuelve 15 niveles con 3 pruebas cada uno (45 en total). En cada prueba verás una sucesión con el último elemento oculto: deduce el patrón y elige la opción correcta entre cuatro. Cada nivel es distinto y la dificultad aumenta; los problemas se generan aleatoriamente.</p>
      <div class="rules-list">
        <div class="rules-list__item"><span class="rules-list__num">1</span>Niveles 1–3 · Números: sumas, operaciones alternadas y series entrelazadas</div>
        <div class="rules-list__item"><span class="rules-list__num">2</span>Niveles 4–6 · Letras: saltos en el alfabeto español</div>
        <div class="rules-list__item"><span class="rules-list__num">3</span>Niveles 7–9 · Figuras: forma, relleno, tamaño y giro</div>
        <div class="rules-list__item"><span class="rules-list__num">4</span>Niveles 10–12 · Flechas: giros y relleno (difícil)</div>
        <div class="rules-list__item"><span class="rules-list__num">5</span>Niveles 13–15 · Relojes: avance de la hora (el más difícil)</div>
      </div>
      <button id="btn-start" class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        Iniciar Prueba
      </button>
    </div>
  </section>

  <!-- SCREEN: INICIO DE NIVEL -->
  <section id="screen-level" class="screen">
    <div class="level-card">
      <span id="level-badge" class="level-card__badge"></span>
      <h2 id="level-title"></h2>
      <p id="level-desc"></p>
      <div id="level-steps" class="level-steps"></div>
      <button id="btn-level-start" class="btn-primary">
        Comenzar nivel
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>
    </div>
  </section>

  <!-- SCREEN: QUIZ -->
  <section id="screen-quiz" class="screen">
    <!-- Top bar -->
    <div class="quiz-topbar">
      <div class="quiz-progress">
        <span id="progress-label">Pregunta 1 / 45</span>
        <div class="quiz-progress__bar"><div id="progress-fill" class="quiz-progress__fill" style="width:0%"></div></div>
      </div>
      <div class="quiz-stats">
        <div class="quiz-stat quiz-stat--correct">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span id="stat-correct">0</span>
        </div>
        <div class="quiz-stat quiz-stat--wrong">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <span id="stat-wrong">0</span>
        </div>
      </div>
      <div id="timer" class="quiz-timer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span id="timer-text">00:00</span>
      </div>
    </div>

    <!-- Question card -->
    <div class="question-card">
      <div id="q-label" class="question-card__label"></div>
      <p id="q-hint" class="question-card__hint"></p>
      <div id="sequence-display" class="sequence-display"></div>
      <div id="explanation" class="explanation" style="display:none">
        <div class="explanation__title">💡 Explicación</div>
        <p id="explanation-text" class="explanation__text"></p>
      </div>
    </div>

    <!-- Options -->
    <div id="options-grid" class="options-grid"></div>

    <!-- Next button -->
    <button id="btn-next" class="btn-primary btn-next" style="display:none">
      Siguiente
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </button>
  </section>

  <!-- SCREEN: RESULTS -->
  <section id="screen-results" class="screen">
    <div class="results-card">
      <div id="results-emoji" class="results-card__emoji"></div>
      <h2 id="results-title"></h2>
      <p id="results-message" class="results-card__message"></p>

      <div class="results-stats">
        <div class="result-stat">
          <div id="res-correct" class="result-stat__value result-stat__value--green">0</div>
          <div class="result-stat__label">Aciertos</div>
        </div>
        <div class="result-stat">
          <div id="res-wrong" class="result-stat__value result-stat__value--red">0</div>
          <div class="result-stat__label">Errores</div>
        </div>
        <div class="result-stat">
          <div id="res-time" class="result-stat__value result-stat__value--cyan">0s</div>
          <div class="result-stat__label">Tiempo Total</div>
        </div>
      </div>

      <div id="results-detail" class="results-detail">
        <div class="results-detail__title">Desglose por categoría</div>
      </div>

      <NavLink id="btn-return-home" href="Estudiante" class="btn-primary" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Regresar al Inicio
      </NavLink>
    </div>
  </section>
</div>

<!-- Feedback toast -->
<div id="feedback" class="feedback"></div>

<!-- Confetti container -->
<div id="confetti" class="confetti-container"></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("iniciarRazonamiento");
        }
    }
}
