  <div class="divider"></div>
  <h1>Sistema de Evaluación de Aprendizaje Cognitivo</h1>
  <a class="back" href="index.html">← Volver al inicio</a>
</header>

<main>
  <div class="intro">
    <h2>Panel de docente</h2>
    <p>Administra tu grupo y consulta las tendencias cognitivas de tus alumnos.</p>
  </div>

  <div class="group-card">
    <div>
      <span>Código de tu grupo</span>
      <!-- id="groupCode" — el <script> de abajo usa este id para
           reemplazar el texto cuando se genera un código nuevo o se
           carga uno ya existente guardado en este navegador -->
      <div class="code" id="groupCode">Sin grupo todavía</div>
    </div>
    <!-- id="genCodeBtn" — el <script> de abajo "escucha" el clic
         de este botón para pedirle al servidor un código nuevo -->
    <button type="button" class="btn btn-outline" id="genCodeBtn">Generar nuevo código</button>
  </div>

  <!-- Para entrar a un grupo que ya existe (por ejemplo, si el docente
       abre el panel desde otra computadora) -->
  <div class="note" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <span>¿Ya tienes un código de grupo?</span>
    <input type="text" id="inputCodigoExistente" placeholder="Ej. 2C23LW" maxlength="6"
      style="text-transform:uppercase; padding:7px 10px; border:1px solid var(--card-border); border-radius:6px; font-family:'Inter',sans-serif; font-size:13px; letter-spacing:0.05em;">
    <button type="button" class="btn-link" id="btnCargarCodigo">Cargar este grupo</button>
  </div>

  <div class="section-title">Resumen del grupo</div>
  <div class="section-sub">Basado en las evaluaciones aplicadas hasta ahora.</div>

  <!-- Tarjetas de resumen. El script de abajo reemplaza estos guiones
       "—" en cuanto hay un grupo cargado con al menos un estudiante. -->
  <div class="stats">
    <div class="stat"><b id="statAlumnos">—</b><span>Alumnos inscritos</span></div>
    <div class="stat"><b id="statEvaluaciones">—</b><span>Evaluaciones completas</span></div>
    <div class="stat"><b id="statFuerte">—</b><span>Área más fuerte</span></div>
    <div class="stat"><b id="statReforzar">—</b><span>Área a reforzar</span></div>
  </div>

  <!-- Gráfica de barras: cada height:XX% en .chart-fill se calcula en
       el script según el promedio real de cada habilidad en el grupo. -->
  <div class="chart-card">
    <div class="example-tag" id="chartTag">Vista de ejemplo</div>
    <div class="section-title">Tendencia cognitiva del grupo</div>
    <div class="section-sub">Promedio por habilidad, una vez que haya evaluaciones completas.</div>
    <div class="chart" id="chartContainer">
      <div class="chart-bar">
        <span class="chart-value" id="chartValMemoria">—</span>
        <div class="chart-fill" id="chartFillMemoria" style="height:0%; background:#1E9E63;"></div>
        <span class="chart-label">Memoria</span>
      </div>
      <div class="chart-bar">
        <span class="chart-value" id="chartValAtencion">—</span>
        <div class="chart-fill" id="chartFillAtencion" style="height:0%; background:#C97B2E;"></div>
        <span class="chart-label">Atención</span>
      </div>
      <div class="chart-bar">
        <span class="chart-value" id="chartValRazonamiento">—</span>
        <div class="chart-fill" id="chartFillRazonamiento" style="height:0%; background:var(--navy);"></div>
        <span class="chart-label">Razonamiento</span>
      </div>
      <div class="chart-bar">
        <span class="chart-value" id="chartValVelocidad">—</span>
        <div class="chart-fill" id="chartFillVelocidad" style="height:0%; background:#D14343;"></div>
        <span class="chart-label">Velocidad</span>
      </div>
    </div>
  </div>

  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
    <div>
      <div class="section-title">Alumnos</div>
      <div class="section-sub" id="alumnosSub">Estado de evaluación por estudiante.</div>
    </div>
    <button type="button" class="btn-link" id="btnActualizar">↻ Actualizar resultados</button>
  </div>

  <!-- Tabla de alumnos. El script de abajo llena <tbody id="tablaAlumnos">
       con una fila real por cada estudiante que se ha unido al grupo. -->
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Alumno</th>
        <th class="res-cell">Memoria</th>
        <th class="res-cell">Atención</th>
        <th class="res-cell">Razonamiento</th>
        <th class="res-cell">Velocidad</th>
        <th>Pruebas completas</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody id="tablaAlumnos">
      <!-- Filas de ejemplo (se reemplazan cuando se une un alumno real) -->
      <tr>
        <td>Alumno de ejemplo 1</td>
        <td class="res-cell"><div class="donut level-strong" style="--pct:86"><b>86%</b></div><span class="donut-lbl">Fuerte</span></td>
        <td class="res-cell"><div class="donut level-avg" style="--pct:58"><b>58%</b></div><span class="donut-lbl">Promedio</span></td>
        <td class="res-cell"><div class="donut level-strong" style="--pct:78"><b>78%</b></div><span class="donut-lbl">Fuerte</span></td>
        <td class="res-cell"><div class="donut level-focus" style="--pct:34"><b>34%</b></div><span class="donut-lbl">Por reforzar</span></td>
        <td>4 / 4</td>
        <td><span class="tag tag-complete">Completo</span></td>
      </tr>
      <tr>
        <td>Alumno de ejemplo 2</td>
        <td class="res-cell"><div class="donut level-avg" style="--pct:62"><b>62%</b></div><span class="donut-lbl">Promedio</span></td>
        <td class="res-cell"><div class="donut level-none"><b>—</b></div><span class="donut-lbl">Pendiente</span></td>
        <td class="res-cell"><div class="donut level-none"><b>—</b></div><span class="donut-lbl">Pendiente</span></td>
        <td class="res-cell"><div class="donut level-none"><b>—</b></div><span class="donut-lbl">Pendiente</span></td>
        <td>1 / 4</td>
        <td><span class="tag tag-progress">En progreso</span></td>
      </tr>
    </tbody>
  </table>
  </div>


  <!-- ============================================================
       TABLA GUÍA: recomendaciones generales para el docente según la
       habilidad y el nivel del alumno (Fuerte / Promedio / Por reforzar).
       Cada celda muestra cuántos alumnos del grupo están en ese nivel.
       ============================================================ -->
  <div class="guia-wrap">
    <div class="section-title">Guía de recomendaciones para el docente</div>
    <div class="section-sub">Estrategias generales para atender las necesidades de tus alumnos según su nivel en cada habilidad.</div>
  </div>
  <div class="table-wrap">
  <table class="guia">
    <thead>
      <tr>
        <th>Habilidad</th>
        <th class="col-fuerte">Fuerte (75% o más)</th>
        <th class="col-promedio">Promedio (50 a 74%)</th>
        <th class="col-reforzar">Por reforzar (menos de 50%)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="skill">Memoria<small>Retención y manejo de información reciente</small></td>
        <td><span class="guia-n" id="guia-memoria-fuerte">— alumnos</span><ul><li>Proyectos que integren varios temas y retos de recuperación sin apuntes.</li><li>Permitir que apoye a compañeros (tutoría entre pares).</li></ul></td>
        <td><span class="guia-n" id="guia-memoria-promedio">— alumnos</span><ul><li>Entregar guías y esquemas previos a la clase.</li><li>Fragmentar el contenido en bloques cortos y repasar al inicio de cada sesión.</li></ul></td>
        <td><span class="guia-n" id="guia-memoria-reforzar">— alumnos</span><ul><li>Sesiones breves con pausas y apoyos visuales (mapas, tarjetas).</li><li>Preguntas de recuperación frecuentes (mini quizzes) con retroalimentación inmediata.</li></ul></td>
      </tr>
      <tr>
        <td class="skill">Atención<small>Concentración y control de distractores</small></td>
        <td><span class="guia-n" id="guia-atencion-fuerte">— alumnos</span><ul><li>Asignar tareas largas o complejas y roles de coordinación.</li><li>Mantener el reto con actividades que exijan sostener el foco.</li></ul></td>
        <td><span class="guia-n" id="guia-atencion-promedio">— alumnos</span><ul><li>Actividades en bloques de 20 a 25 minutos con cambios de dinámica.</li><li>Dar instrucciones claras, una a la vez, y reducir distractores del aula.</li></ul></td>
        <td><span class="guia-n" id="guia-atencion-reforzar">— alumnos</span><ul><li>Ubicarlo cerca del docente y lejos de distractores.</li><li>Dividir las tareas en pasos con lista de verificación y pausas activas.</li><li>Si persiste, canalizar a tutoría o apoyo psicopedagógico.</li></ul></td>
      </tr>
      <tr>
        <td class="skill">Razonamiento<small>Detección de patrones y lógica</small></td>
        <td><span class="guia-n" id="guia-razonamiento-fuerte">— alumnos</span><ul><li>Casos abiertos, proyectos y debates.</li><li>Preguntas de nivel superior (analizar, evaluar, crear).</li></ul></td>
        <td><span class="guia-n" id="guia-razonamiento-promedio">— alumnos</span><ul><li>Modelar la resolución paso a paso.</li><li>Ejercicios graduados y pedir que explique su razonamiento.</li></ul></td>
        <td><span class="guia-n" id="guia-razonamiento-reforzar">— alumnos</span><ul><li>Partir de ejemplos concretos y visuales.</li><li>Problemas pequeños con apoyo (andamiaje), trabajo en parejas y retroalimentación sobre el proceso, no solo la respuesta.</li></ul></td>
      </tr>
      <tr>
        <td class="skill">Velocidad<small>Rapidez de procesamiento y respuesta</small></td>
        <td><span class="guia-n" id="guia-velocidad-fuerte">— alumnos</span><ul><li>Actividades cronometradas de mayor exigencia.</li><li>Invitarlo a revisar sus respuestas antes de entregar.</li></ul></td>
        <td><span class="guia-n" id="guia-velocidad-promedio">— alumnos</span><ul><li>Ejercicios con tiempo progresivo.</li><li>Enseñar gestión del tiempo en exámenes.</li></ul></td>
        <td><span class="guia-n" id="guia-velocidad-reforzar">— alumnos</span><ul><li>Práctica sin presión antes de cronometrar y, cuando sea razonable, tiempo adicional.</li><li>Evitar comparaciones públicas y revisar en tutoría factores externos (sueño, estrés).</li></ul></td>
      </tr>
      <tr>
        <td class="skill">Estilo de aprendizaje<small>Apoyo a cualquier nivel (según el cuestionario del alumno)</small></td>
        <td colspan="3"><ul>
          <li><b>Visual:</b> esquemas, mapas mentales, colores, videos e imágenes.</li>
          <li><b>Auditivo:</b> explicaciones orales, discusión en grupo, grabaciones y podcasts.</li>
          <li><b>Kinestésico:</b> prácticas, simulaciones, actividades con movimiento y pausas activas.</li>
        </ul></td>
      </tr>
    </tbody>
  </table>
  </div>

  <div class="note" id="notaFinal">El grupo aún no tiene alumnos ni evaluaciones registradas — genera un código y compártelo con tus estudiantes para que empiecen a aparecer aquí.</div>
</main>

<footer>
  Instituto Tecnológico de Tijuana · Departamento de Sistemas y Computación<br>
  <span style="opacity:0.75;">Criterios de evaluación y recomendaciones validados con apoyo de un especialista en psicología educativa.</span>
</footer>

<!-- ============================================================
     JAVASCRIPT: generación de código + carga de resultados reales
     ============================================================ -->
<script>
  const btn = document.getElementById('genCodeBtn');
  const codeEl = document.getElementById('groupCode');
  const inputCodigoExistente = document.getElementById('inputCodigoExistente');
  const btnCargarCodigo = document.getElementById('btnCargarCodigo');
  const btnActualizar = document.getElementById('btnActualizar');

  // Pequeño efecto visual: el código "destella" en color ámbar y luego
  // regresa suavemente al azul marino normal, para que se note el cambio.
  function destellarCodigo() {
    codeEl.style.transition = 'none';
    codeEl.style.color = '#C97B2E';
    requestAnimationFrame(() => {
      codeEl.style.transition = 'color .6s ease';
      codeEl.style.color = '#1A3560';
    });
  }

  // ── Generar un código de grupo NUEVO (pide uno real al servidor) ──
function dbLocal() {
    try { var d = JSON.parse(localStorage.getItem('evaluacionCognitiva')); if (d && d.grupos) return d; } catch (e) {}
    return { grupos: [], estudiantes: [], resultados: [], sig: { g: 1, e: 1, r: 1 } };
  }
  function guardarDb(d) { localStorage.setItem('evaluacionCognitiva', JSON.stringify(d)); }
  function resumenLocal(d, id) {
    var o = {};
    ['memoria', 'atencion', 'razonamiento', 'velocidad'].forEach(function (p) {
      var l = d.resultados.filter(function (r) { return r.estudiante_id === id && r.prueba === p; });
      o[p] = l[l.length - 1] || null;
    });
    return o;
  }

  async function generarCodigoNuevo() {
    btn.disabled = true;
    try {
      // SIN BACKEND: el código se genera aquí y se guarda en este navegador
      const d = dbLocal();
      const C = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      let codigo;
      do { codigo = ''; for (let i = 0; i < 6; i++) codigo += C.charAt(Math.floor(Math.random() * C.length)); }
      while (d.grupos.some((g) => g.codigo === codigo));
      const grupoNuevo = { id: d.sig.g++, codigo, nombre: 'Grupo sin nombre', creado_en: new Date().toISOString() };
      d.grupos.push(grupoNuevo);
      guardarDb(d);
      const data = { ok: true, grupo: grupoNuevo };

      localStorage.setItem('grupoDocenteCodigo', data.grupo.codigo);
      codeEl.textContent = data.grupo.codigo;
      destellarCodigo();
      cargarDatosGrupo(data.grupo.codigo);
    } catch (err) {
      alert('No se pudo generar el código.');
    } finally {
      btn.disabled = false;
    }
  }

  btn.addEventListener('click', generarCodigoNuevo);

  btnCargarCodigo.addEventListener('click', () => {
    const codigo = inputCodigoExistente.value.trim().toUpperCase();
    if (!codigo) return;
    localStorage.setItem('grupoDocenteCodigo', codigo);
    codeEl.textContent = codigo;
    destellarCodigo();
    cargarDatosGrupo(codigo);
  });

  btnActualizar.addEventListener('click', () => {
    const codigo = localStorage.getItem('grupoDocenteCodigo');
    if (codigo) cargarDatosGrupo(codigo);
  });

  // ── Cargar y pintar los resultados reales de un grupo ──
  const PRUEBAS = ['memoria', 'atencion', 'razonamiento', 'velocidad'];
  const NOMBRES_PRUEBA = { memoria: 'Memoria', atencion: 'Atención', razonamiento: 'Razonamiento', velocidad: 'Velocidad' };
  const COLOR_PRUEBA = { memoria: '#1E9E63', atencion: '#C97B2E', razonamiento: '#1A3560', velocidad: '#D14343' };

  async function cargarDatosGrupo(codigo) {
    try {
      const d = dbLocal();
      const grupo = d.grupos.filter((g) => g.codigo === String(codigo).toUpperCase())[0];
      if (!grupo) throw new Error('Grupo no encontrado');
      const data = { estudiantes: d.estudiantes.filter((e) => e.grupo_id === grupo.id)
        .map((e) => ({ estudiante: e, resumen: resumenLocal(d, e.id) })) };

      pintarDashboard(data.estudiantes);
    } catch (err) {
      document.getElementById('notaFinal').textContent =
        'No se encontró ese código de grupo en este navegador.';
    }
  }

  // Cuenta cuántos alumnos del grupo hay en cada nivel de cada habilidad
  // y lo muestra en la tabla guía (según su resultado más reciente).
  function pintarGuia(estudiantes) {
    PRUEBAS.forEach((prueba) => {
      const conteo = { fuerte: 0, promedio: 0, reforzar: 0 };
      estudiantes.forEach(({ resumen }) => {
        if (!resumen[prueba]) return;
        const pts = Math.round(resumen[prueba].puntaje);
        if (pts >= 75) conteo.fuerte++;
        else if (pts >= 50) conteo.promedio++;
        else conteo.reforzar++;
      });
      Object.keys(conteo).forEach((nivel) => {
        const el = document.getElementById('guia-' + prueba + '-' + nivel);
        if (!el) return;
        el.textContent = conteo[nivel] + (conteo[nivel] === 1 ? ' alumno' : ' alumnos');
        el.classList.toggle('has', conteo[nivel] > 0);
      });
    });
  }

  function pintarDashboard(estudiantes) {
    pintarGuia(estudiantes);
    document.getElementById('statAlumnos').textContent = estudiantes.length;

    let evaluacionesCompletas = 0;
    const sumas = { memoria: 0, atencion: 0, razonamiento: 0, velocidad: 0 };
    const conteos = { memoria: 0, atencion: 0, razonamiento: 0, velocidad: 0 };

    estudiantes.forEach(({ resumen }) => {
      PRUEBAS.forEach((prueba) => {
        if (resumen[prueba]) {
          evaluacionesCompletas++;
          sumas[prueba] += resumen[prueba].puntaje;
          conteos[prueba]++;
        }
      });
    });

    document.getElementById('statEvaluaciones').textContent = evaluacionesCompletas;

    // Promedios por prueba (null si nadie la ha completado todavía)
    const promedios = {};
    PRUEBAS.forEach((prueba) => {
      promedios[prueba] = conteos[prueba] > 0 ? Math.round(sumas[prueba] / conteos[prueba]) : null;
    });

    const pruebasConDatos = PRUEBAS.filter((p) => promedios[p] !== null);
    if (pruebasConDatos.length > 0) {
      const masFuerte = pruebasConDatos.reduce((a, b) => (promedios[a] >= promedios[b] ? a : b));
      const aReforzar = pruebasConDatos.reduce((a, b) => (promedios[a] <= promedios[b] ? a : b));
      document.getElementById('statFuerte').textContent = NOMBRES_PRUEBA[masFuerte];
      document.getElementById('statReforzar').textContent = NOMBRES_PRUEBA[aReforzar];
    } else {
      document.getElementById('statFuerte').textContent = '—';
      document.getElementById('statReforzar').textContent = '—';
    }

    // Gráfica de barras
    document.getElementById('chartTag').textContent = estudiantes.length > 0 ? 'Datos reales del grupo' : 'Vista de ejemplo';
    PRUEBAS.forEach((prueba) => {
      const promedio = promedios[prueba];
      const sufijo = prueba.charAt(0).toUpperCase() + prueba.slice(1);
      const valorEl = document.getElementById('chartVal' + sufijo);
      const fillEl = document.getElementById('chartFill' + sufijo);
      valorEl.textContent = promedio !== null ? promedio + '%' : '—';
      fillEl.style.height = (promedio !== null ? promedio : 0) + '%';
      fillEl.style.background = COLOR_PRUEBA[prueba];
    });

    // Tabla de alumnos
    const tbody = document.getElementById('tablaAlumnos');
    if (estudiantes.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--muted);">Todavía no se ha unido ningún estudiante con este código.</td></tr>';
    } else {
      tbody.innerHTML = estudiantes.map(({ estudiante, resumen }) => {
        const completas = PRUEBAS.filter((p) => resumen[p]).length;
        let tagClase = 'tag-pending', tagTexto = 'Pendiente';
        if (completas === PRUEBAS.length) { tagClase = 'tag-complete'; tagTexto = 'Completo'; }
        else if (completas > 0) { tagClase = 'tag-progress'; tagTexto = 'En progreso'; }

        // Una gráfica circular por prueba, con el mismo criterio de color
        // que ve el alumno: >=75 Fuerte, >=50 Promedio, menos Por reforzar.
        const celdas = PRUEBAS.map((p) => {
          if (!resumen[p]) return '<td class="res-cell"><div class="donut level-none"><b>—</b></div><span class="donut-lbl">Pendiente</span></td>';
          const pts = Math.max(0, Math.min(100, Math.round(resumen[p].puntaje)));
          let clase = 'level-focus', texto = 'Por reforzar';
          if (pts >= 75) { clase = 'level-strong'; texto = 'Fuerte'; }
          else if (pts >= 50) { clase = 'level-avg'; texto = 'Promedio'; }
          return `<td class="res-cell"><div class="donut ${clase}" style="--pct:${pts}"><b>${pts}%</b></div><span class="donut-lbl">${texto}</span></td>`;
        }).join('');

        return `<tr>
          <td>${estudiante.nombre}</td>
          ${celdas}
          <td>${completas} / ${PRUEBAS.length}</td>
          <td><span class="tag ${tagClase}">${tagTexto}</span></td>
        </tr>`;
      }).join('');
    }

    document.getElementById('notaFinal').textContent = estudiantes.length > 0
      ? 'Los resultados se actualizan según tus alumnos van completando las 4 pruebas. Usa "Actualizar resultados" para ver lo más reciente.'
      : 'El grupo aún no tiene alumnos — comparte el código de arriba para que empiecen a aparecer aquí.';
  }

  // ── Al cargar la página: si ya había un grupo guardado en este
  //    navegador, lo mostramos y cargamos sus datos automáticamente ──
  (function init() {
    const codigoGuardado = localStorage.getItem('grupoDocenteCodigo');
    if (codigoGuardado) {
      codeEl.textContent = codigoGuardado;
      cargarDatosGrupo(codigoGuardado);
    }
  })();
</script>