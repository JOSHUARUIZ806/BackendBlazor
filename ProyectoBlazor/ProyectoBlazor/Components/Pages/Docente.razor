@page "/Docente"
@inject NavigationManager Navigation
<PageTitle>Docente — Evaluación Cognitiva</PageTitle>

<style>
  /* Mismas variables de color que las otras 2 páginas */
  :root{
    --navy:#1A3560;
    --navy-dark:#132848;
    --amber:#C97B2E;
    --ink:#1F2937;
    --muted:#6B7280;
    --card-bg:#F6F7F8;
    --card-border:#ECEDEF;
    --bg:#FFFFFF;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  body{ font-family:'Inter', sans-serif; background:var(--bg); color:var(--ink); }

  header{
    background:var(--navy); color:white; display:flex; align-items:center;
    padding:18px 40px; gap:16px;
  }
  .logo{ height:38px; width:auto; flex-shrink:0; shape-rendering:geometricPrecision; }
  .divider{ width:1px; height:34px; background:rgba(255,255,255,0.25); flex-shrink:0; }
  header h1{ font-size:19px; font-weight:600; }
  .back{
    margin-left:auto; font-size:13px; color:white; opacity:0.85; text-decoration:none;
  }
  .back:hover{ opacity:1; }

  main{ max-width:820px; margin:0 auto; padding:56px 24px 100px; }

  .intro{ text-align:center; margin-bottom:40px; }
  .intro h2{ font-size:22px; font-weight:600; }
  .intro p{ font-size:14.5px; color:var(--muted); margin-top:8px; }

  /* Tarjeta de arriba: muestra el código de grupo y el botón para
     generar uno nuevo (la lógica de ese botón está al final del
     archivo, en el script). */
  .group-card{
    background:var(--card-bg); border:1px solid var(--card-border); border-radius:12px;
    padding:28px 32px; display:flex; justify-content:space-between; align-items:center;
    margin-bottom:44px; flex-wrap:wrap; gap:16px;
  }
  .group-card div span{ display:block; font-size:12px; color:var(--muted); margin-bottom:4px; }
  .code{
    font-family:'Inter', sans-serif; font-size:22px; font-weight:700; color:var(--navy);
    letter-spacing:0.06em;
  }
  .btn{
    background:var(--navy); color:white; border:none; padding:12px 20px; border-radius:8px;
    font-size:13.5px; font-weight:600; font-family:'Inter', sans-serif; cursor:pointer;
  }
  .btn:hover{ background:var(--navy-dark); }
  /* Variante de botón con fondo blanco y borde, en vez del navy sólido
     (usada en "Generar nuevo código" para que no compita visualmente
     con el botón principal). */
  .btn-outline{
    background:white; color:var(--navy); border:1px solid var(--card-border);
  }

  .section-title{ font-size:15px; font-weight:600; color:var(--navy); margin-bottom:4px; }
  .section-sub{ font-size:13.5px; color:var(--muted); margin-bottom:20px; }

  /* Las 4 tarjetas pequeñas con los números resumen
     (Alumnos inscritos, Evaluaciones completas, etc.) */
  .stats{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:48px; }
  .stat{
    border:1px solid var(--card-border); border-radius:10px; padding:18px; text-align:center;
    background:var(--card-bg);
  }
  .stat b{ display:block; font-size:24px; color:var(--navy); }
  .stat span{ font-size:11.5px; color:var(--muted); }

  /* Tabla de "Alumnos": lista con nombre, matrícula y estado */
  table{ width:100%; border-collapse:collapse; font-size:13.5px; }
  th{
    text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:0.04em;
    color:var(--muted); padding:10px 12px; border-bottom:1px solid var(--card-border);
  }
  td{ padding:12px; border-bottom:1px solid var(--card-border); }
  /* Etiqueta redonda ámbar para el estado "Pendiente" en la tabla */
  .tag{
    font-size:11px; font-weight:600; padding:3px 9px; border-radius:20px;
    background:#FBEFE1; color:var(--amber);
  }
  .tag-complete{ background:#E3F5EC; color:#1E9E63; }
  .tag-progress{ background:#FBEFE1; color:var(--amber); }
  .tag-pending{ background:#ECEDEF; color:var(--muted); }

  /* Resultado por prueba de cada alumno: gráfica circular (pastel/dona)
     con el porcentaje al centro. El color depende del nivel, igual que
     en "Tus resultados" del alumno: >=75 verde, >=50 ámbar, menos rojo.
     --pct define cuánto del círculo se rellena (conic-gradient). */
  .table-wrap{ overflow-x:auto; }
  .res-cell{ text-align:center; white-space:nowrap; }
  th.res-cell{ text-align:center; }
  td .tag{ white-space:nowrap; }
  .donut{
    --pct:0; --col:#1E9E63;
    width:52px; height:52px; border-radius:50%; margin:0 auto;
    background:conic-gradient(var(--col) calc(var(--pct) * 1%), #E5E7EB 0);
    display:flex; align-items:center; justify-content:center; position:relative;
  }
  .donut::before{ content:''; position:absolute; inset:7px; border-radius:50%; background:#fff; }
  .donut b{ position:relative; font-size:11.5px; font-weight:700; color:var(--navy); }
  .donut.level-strong{ --col:#1E9E63; }
  .donut.level-avg{ --col:#F2C230; }  /* amarillo = Promedio */
  .donut.level-focus{ --col:#D14343; }
  .donut.level-none b{ color:var(--muted); font-weight:600; }
  .donut-lbl{ display:block; margin-top:4px; font-size:10px; font-weight:700; letter-spacing:0.03em; text-transform:uppercase; color:var(--muted); }

  .btn-link{
    background:none; border:none; color:var(--navy); font-size:12.5px; font-weight:600;
    font-family:'Inter', sans-serif; cursor:pointer; text-decoration:underline; padding:0;
  }

  .note{
    margin-top:28px; font-size:12.5px; color:var(--muted); background:var(--card-bg);
    border:1px solid var(--card-border); border-radius:8px; padding:14px 16px;
  }

  .example-tag{
    display:inline-block; font-size:10.5px; font-weight:700; text-transform:uppercase;
    letter-spacing:0.05em; color:var(--amber); background:#FBEFE1; padding:3px 9px;
    border-radius:20px; margin-bottom:14px;
  }

  /* ============================================================
     GRÁFICA DE BARRAS "Tendencia cognitiva del grupo"
     Está hecha solo con CSS (sin ninguna librería de gráficas):
     cada .chart-fill es una barra cuya altura se define en línea
     con style="height:XX%" directamente en el HTML.
     ============================================================ */
  .chart-card{
    border:1px solid var(--card-border); border-radius:12px; padding:28px 32px;
    background:white; margin-bottom:48px;
  }
  /* align-items:flex-end hace que todas las barras "crezcan" desde
     abajo, como una gráfica de barras normal */
  .chart{ display:flex; align-items:flex-end; gap:28px; height:150px; margin-top:24px; padding:0 8px; }
  .chart-bar{ flex:1; display:flex; flex-direction:column; align-items:center; gap:8px; height:100%; justify-content:flex-end; }
  .chart-fill{ width:100%; max-width:56px; border-radius:6px 6px 0 0; background:var(--navy); position:relative; }
  .chart-value{ font-size:12px; font-weight:700; color:var(--navy); margin-bottom:4px; }
  .chart-label{ font-size:11.5px; color:var(--muted); margin-top:8px; text-align:center; }


  /* Tabla guía de recomendaciones para el docente */
  .guia-wrap{ margin-top:48px; }
  .guia{ table-layout:fixed; min-width:760px; font-size:12.5px; }
  .guia th, .guia td{ vertical-align:top; line-height:1.45; }
  .guia th.col-fuerte{ color:#1E9E63; }
  .guia th.col-promedio{ color:#92400E; }
  .guia th.col-reforzar{ color:#D14343; }
  .guia td.skill{ font-weight:700; color:var(--navy); width:15%; }
  .guia td.skill small{ display:block; font-weight:400; color:var(--muted); margin-top:3px; font-size:11.5px; }
  .guia ul{ margin:0; padding-left:16px; }
  .guia li{ margin-bottom:3px; }
  .guia-n{
    display:inline-block; margin-bottom:6px; font-size:10.5px; font-weight:700; letter-spacing:0.03em;
    text-transform:uppercase; padding:2px 8px; border-radius:20px; background:#ECEDEF; color:var(--muted);
  }
  .guia-n.has{ background:#E8EEF8; color:var(--navy); }

  footer{ text-align:center; padding:30px 24px 40px; font-size:12px; color:var(--muted); }

  @@media (max-width:640px){
    .stats{ grid-template-columns:1fr 1fr; }
    header{ padding:16px 20px; }
    .back{ display:none; }
    table{ font-size:12px; }
  }
</style>

