@page "/Instrucciones"
@inject NavigationManager Navigation
<PageTitle>Instrucciones — Evaluación Cognitiva</PageTitle>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     VARIABLES DE DISEÑO (mismas que el resto del sitio)
     ============================================================ */
  :root{
    --navy:#1A3560;
    --navy-dark:#132848;
    --amber:#C97B2E;
    --ink:#1F2937;
    --muted:#6B7280;
    --card-bg:#F6F7F8;
    --card-border:#ECEDEF;
    --bg:#FFFFFF;

    /* Colores de nivel de desempeño (iguales a Estudiantes y Docente) */
    --strong:#1E9E63;   --strong-bg:#E3F5EC;
    --avg:#F2C230;      --avg-bg:#FEF3C7;   --avg-ink:#92400E;
    --focus:#D14343;    --focus-bg:#FDEBEB;
  }
  .guia, .guia *{ box-sizing:border-box; }
  .guia{ margin:0; padding:0; }
  html{ scroll-padding-top:72px; }
  .guia{ overflow-x:clip; }
  .guia{ font-family:'Inter', sans-serif; background:var(--bg); color:var(--ink); line-height:1.55; }

  /* ── Encabezado (igual que las demás páginas) ── */
  header.top{
    background:var(--navy); color:white; display:flex; align-items:center;
    padding:18px 40px; gap:16px;
  }
  .logo{ height:38px; width:auto; flex-shrink:0; }
  .divider{ width:1px; height:34px; background:rgba(255,255,255,0.25); flex-shrink:0; }
  header.top h1{ font-size:19px; font-weight:600; }
  .back{ margin-left:auto; font-size:13px; color:white; opacity:0.85; text-decoration:none; }
  .back:hover{ opacity:1; }

  /* ── Barra de progreso de lectura (arriba, ámbar) ── */
  .progress{
    position:fixed; top:0; left:0; height:3px; width:100%; z-index:60;
    background:var(--amber); transform-origin:left; transform:scaleX(0);
  }

  /* ── Menú de secciones (se queda fijo al bajar) ── */
  .subnav{
    position:sticky; top:0; z-index:50;
    background:rgba(255,255,255,0.92); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
    border-bottom:1px solid var(--card-border);
  }
  .subnav-inner{
    max-width:980px; margin:0 auto; padding:10px 24px;
    display:flex; gap:6px; overflow-x:auto; scrollbar-width:none;
  }
  .subnav-inner::-webkit-scrollbar{ display:none; }
  .subnav a{
    flex-shrink:0; font-size:13px; font-weight:600; color:var(--muted); text-decoration:none;
    padding:7px 14px; border-radius:20px; border:1px solid transparent;
    transition:color .2s, background .2s, border-color .2s;
  }
  .subnav a:hover{ color:var(--navy); background:var(--card-bg); }
  .subnav a.active{ color:var(--navy); background:#E9EEF6; border-color:rgba(26,53,96,0.18); }

  main{ max-width:980px; margin:0 auto; padding:0 24px 40px; }
  section{ padding-top:72px; }

  /* ── Títulos de sección ── */
  .eyebrow{
    display:inline-block; font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--amber); background:#FBEFE1; padding:4px 12px; border-radius:20px; margin-bottom:12px;
  }
  .eyebrow.blue{ color:var(--navy); background:#E9EEF6; }
  h2.sec-title{ font-size:28px; font-weight:800; letter-spacing:-0.02em; color:var(--navy); line-height:1.2; text-wrap:balance; }
  .sec-sub{ font-size:15px; color:var(--muted); margin-top:10px; max-width:62ch; }
  .sec-head{ margin-bottom:32px; }

  /* ============================================================
     ANIMACIÓN AL BAJAR
     Los elementos con la clase .reveal aparecen suavemente
     cuando entran en pantalla. Si el navegador no ejecuta
     JavaScript, todo se ve normal (sin animación).
     ============================================================ */
  .js .reveal{
    opacity:0; transform:translateY(30px);
    transition:opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1);
    transition-delay:var(--d, 0s);
  }
  .js .reveal.from-left{ transform:translateX(-30px); }
  .js .reveal.zoom{ transform:scale(.94); }
  .js .reveal.visible{ opacity:1; transform:none; }

  /* ── Portada de la guía (sin imágenes) ── */
  .hero{ padding-top:64px; text-align:center; }
  .hero h2{ font-size:clamp(30px,5vw,44px); font-weight:800; letter-spacing:-0.03em; line-height:1.12; color:var(--navy); text-wrap:balance; max-width:20ch; margin:0 auto; }
  .hero p.lead{ font-size:16.5px; color:var(--muted); margin:16px auto 0; max-width:58ch; }
  .cta-row{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:28px; }
  .btn{
    display:inline-flex; align-items:center; gap:8px; text-decoration:none; font-family:inherit;
    font-size:14.5px; font-weight:700; padding:13px 26px; border-radius:10px; cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .btn:hover{ transform:translateY(-2px); }
  .btn-primary{ background:var(--navy); color:#fff; border:1px solid var(--navy); box-shadow:0 4px 16px rgba(26,53,96,0.25); }
  .btn-primary:hover{ background:var(--navy-dark); box-shadow:0 8px 24px rgba(26,53,96,0.32); }
  .btn-outline{ background:#fff; color:var(--navy); border:1px solid var(--card-border); }
  .btn-outline:hover{ border-color:var(--navy); box-shadow:0 6px 18px rgba(26,53,96,0.1); }
  .facts{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:30px; }
  .fact{
    font-size:13px; font-weight:600; color:var(--navy); background:var(--card-bg);
    border:1px solid var(--card-border); border-radius:20px; padding:8px 16px;
  }
  .fact b{ color:var(--amber); }

  /* ── Tarjetas generales ── */
  .card{
    background:var(--card-bg); border:1px solid var(--card-border); border-radius:12px; padding:24px;
    transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .card:hover{ transform:translateY(-3px); box-shadow:0 10px 26px rgba(26,53,96,0.08); border-color:rgba(26,53,96,0.2); }
  .card h3{ font-size:16px; font-weight:700; color:var(--navy); margin-bottom:6px; }
  .card p{ font-size:14px; color:var(--muted); }
  .grid-3{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .grid-2{ display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
  .mark{ display:block; width:36px; height:4px; border-radius:2px; background:var(--amber); margin-bottom:14px; }

  /* ── Pasos (línea de tiempo) ── */
  .steps{ list-style:none; position:relative; padding-left:0; }
  .steps::before{
    content:''; position:absolute; left:19px; top:8px; bottom:8px; width:2px;
    background:linear-gradient(var(--navy), rgba(26,53,96,0.15));
  }
  .step{ position:relative; display:flex; gap:20px; padding-bottom:26px; }
  .step:last-child{ padding-bottom:0; }
  .step-num{
    flex-shrink:0; width:40px; height:40px; border-radius:50%; z-index:1;
    background:var(--navy); color:#fff; font-weight:700; font-size:15px;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 0 5px #fff;
  }
  .step.amber .step-num{ background:var(--amber); }
  .step-body{ padding-top:6px; flex:1; min-width:0; }
  .step-body h3{ font-size:16.5px; font-weight:700; color:var(--ink); }
  .step-body p{ font-size:14.5px; color:var(--muted); margin-top:3px; max-width:62ch; }
  .step-body p b, .card p b{ color:var(--ink); font-weight:600; }
  kbd, .ui{
    font-family:inherit; font-size:12.5px; font-weight:600; color:var(--navy);
    background:#E9EEF6; border-radius:6px; padding:1px 8px; white-space:nowrap;
  }

  /* ── Tarjetas de las 4 pruebas ── */
  .test{ display:flex; flex-direction:column; gap:12px; background:#fff; }
  .test-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
  .test h3{ font-size:18px; }
  .skill{
    font-size:10.5px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase;
    padding:4px 10px; border-radius:20px; white-space:nowrap;
  }
  .skill.s1{ background:var(--strong-bg); color:var(--strong); }
  .skill.s2{ background:#FBEFE1; color:var(--amber); }
  .skill.s3{ background:#E9EEF6; color:var(--navy); }
  .skill.s4{ background:var(--focus-bg); color:var(--focus); }
  .test ul{ list-style:none; display:flex; flex-direction:column; gap:8px; }
  .test li{ position:relative; padding-left:18px; font-size:14px; color:var(--muted); }
  .test li::before{ content:''; position:absolute; left:2px; top:9px; width:7px; height:7px; border-radius:50%; background:var(--amber); }
  .test li b{ color:var(--ink); font-weight:600; }
  .ends{
    margin-top:auto; font-size:13px; color:var(--ink); background:var(--card-bg);
    border-left:3px solid var(--navy); border-radius:0 8px 8px 0; padding:10px 14px;
  }
  .ends b{ color:var(--navy); }

  /* ── Aviso importante ── */
  .callout{
    background:#FFF8EC; border:1px solid #F3D9B0; border-radius:12px; padding:22px 26px;
  }
  .callout h3{ font-size:16px; font-weight:700; color:#8A5016; margin-bottom:10px; }
  .callout ul{ list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:10px 28px; }
  .callout li{ font-size:14px; color:#6B4A1F; padding-left:20px; position:relative; }
  .callout li::before{ content:'!'; position:absolute; left:0; top:1px; width:14px; height:14px; border-radius:50%; background:var(--amber); color:#fff; font-size:10px; font-weight:800; display:flex; align-items:center; justify-content:center; }

  /* ── Niveles de resultado ── */
  .levels{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .level-card{ background:#fff; border:1px solid var(--card-border); border-radius:12px; padding:22px; overflow:hidden; position:relative; }
  .level-card .bar{ height:6px; border-radius:4px; background:var(--card-border); margin:14px 0 12px; overflow:hidden; }
  .level-card .bar i{ display:block; height:100%; width:0; border-radius:4px; transition:width 1.1s cubic-bezier(.2,.7,.2,1) .25s; }
  .level-card.visible .bar i{ width:var(--w); }
  .pill{ display:inline-block; font-size:11px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; padding:4px 12px; border-radius:20px; }
  .pill.strong{ background:var(--strong-bg); color:var(--strong); }
  .pill.avg{ background:var(--avg-bg); color:var(--avg-ink); }
  .pill.focus{ background:var(--focus-bg); color:var(--focus); }
  .level-card .range{ font-size:22px; font-weight:800; color:var(--ink); margin-top:10px; }
  .level-card p{ font-size:13.5px; color:var(--muted); }
  .no-js-bar{ display:none; }

  /* ── Estilos de aprendizaje ── */
  .styles{ display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:16px; }
  .style-chip{ background:#fff; border:1px solid var(--card-border); border-radius:10px; padding:14px 16px; font-size:13.5px; color:var(--muted); }
  .style-chip b{ display:block; color:var(--navy); font-size:14.5px; margin-bottom:2px; }

  /* ── Panel del docente: lista de elementos ── */
  .feature{ display:flex; gap:16px; background:#fff; }
  .feature .tag{
    flex-shrink:0; width:38px; height:38px; border-radius:10px; background:#E9EEF6; color:var(--navy);
    font-weight:800; font-size:14px; display:flex; align-items:center; justify-content:center;
  }
  .states{ display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
  .st{ font-size:11px; font-weight:600; padding:3px 10px; border-radius:20px; }
  .st.c{ background:#E3F5EC; color:#1E9E63; } .st.p{ background:#FBEFE1; color:var(--amber); } .st.n{ background:#ECEDEF; color:var(--muted); }
  .mini-donuts{ display:flex; gap:10px; margin-top:12px; }
  .mini-donut{
    --pct:0; --col:var(--strong); width:42px; height:42px; border-radius:50%; position:relative;
    background:conic-gradient(var(--col) calc(var(--pct) * 1%), #E5E7EB 0);
    display:flex; align-items:center; justify-content:center; font-size:10.5px; font-weight:700; color:var(--navy);
  }
  .mini-donut::before{ content:''; position:absolute; inset:6px; border-radius:50%; background:#fff; }
  .mini-donut span{ position:relative; }

  /* ── Preguntas frecuentes ── */
  .faq{ display:flex; flex-direction:column; gap:10px; }
  .faq-item{ border:1px solid var(--card-border); border-radius:10px; background:#fff; overflow:hidden; }
  .faq-q{
    width:100%; display:flex; justify-content:space-between; align-items:center; gap:14px; text-align:left;
    font-family:inherit; font-size:15px; font-weight:600; color:var(--ink); background:none; border:none;
    padding:16px 20px; cursor:pointer;
  }
  .faq-q:hover{ color:var(--navy); }
  .faq-q:focus-visible, .btn:focus-visible, .subnav a:focus-visible{ outline:2px solid var(--navy); outline-offset:2px; }
  .faq-q .plus{ flex-shrink:0; width:24px; height:24px; border-radius:50%; background:#E9EEF6; position:relative; transition:transform .3s ease, background .3s; }
  .faq-q .plus::before, .faq-q .plus::after{ content:''; position:absolute; left:50%; top:50%; width:10px; height:2px; background:var(--navy); transform:translate(-50%,-50%); }
  .faq-q .plus::after{ transform:translate(-50%,-50%) rotate(90deg); transition:transform .3s ease; }
  .faq-item.open .plus{ background:var(--navy); transform:rotate(180deg); }
  .faq-item.open .plus::before{ background:#fff; }
  .faq-item.open .plus::after{ background:#fff; transform:translate(-50%,-50%) rotate(0deg); }
  .faq-a{ display:grid; grid-template-rows:0fr; transition:grid-template-rows .35s ease; }
  .faq-item.open .faq-a{ grid-template-rows:1fr; }
  .faq-a > div{ overflow:hidden; }
  .faq-a p{ padding:0 20px 18px; font-size:14.5px; color:var(--muted); max-width:70ch; }

  /* ── Cierre ── */
  .final{
    margin-top:72px; text-align:center; background:var(--navy); color:#fff; border-radius:16px; padding:48px 28px;
  }
  .final h2{ font-size:26px; font-weight:800; letter-spacing:-0.02em; text-wrap:balance; }
  .final p{ font-size:15px; color:rgba(255,255,255,0.78); margin:10px auto 0; max-width:50ch; }
  .final .btn-primary{ background:var(--amber); border-color:var(--amber); box-shadow:0 4px 16px rgba(0,0,0,0.2); }
  .final .btn-primary:hover{ background:#B56C25; }
  .final .btn-outline{ background:transparent; color:#fff; border-color:rgba(255,255,255,0.4); }
  .final .btn-outline:hover{ border-color:#fff; box-shadow:none; }
  .note{
    margin-top:28px; font-size:12.5px; color:var(--muted); background:var(--card-bg);
    border:1px solid var(--card-border); border-radius:8px; padding:14px 16px;
  }

  footer{ text-align:center; padding:30px 24px 40px; font-size:12px; color:var(--muted); }

  /* ── Pantallas pequeñas ── */
  @@media (max-width:760px){
    header.top{ padding:16px 20px; }
    header.top{ gap:12px; }
    header.top h1{ font-size:14px; line-height:1.25; min-width:0; }
    .logo{ height:30px; }
    .divider{ height:28px; }
    .back{ display:none; }
    .grid-3, .grid-2, .levels, .styles{ grid-template-columns:1fr; }
    .callout ul{ grid-template-columns:1fr; }
    h2.sec-title{ font-size:24px; }
    section{ padding-top:56px; }
    .final{ padding:36px 20px; }
  }


  /* ── Espacios para imágenes (reemplázalos por tus capturas) ── */
  .shot{
    position:relative; width:100%; aspect-ratio:16/9; margin-top:14px; border-radius:10px; overflow:hidden;
    border:2px dashed #C9D3E3; background:#F6F8FB;
    display:flex; align-items:center; justify-content:center; text-align:center; padding:12px;
  }
  .shot img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .shot:has(img){ border:1px solid var(--card-border); background:none; }
  .shot.wide{ aspect-ratio:21/9; margin-top:36px; }
  .shot.sm{ aspect-ratio:2/1; }
  .tip-card{ background:#fff; }
  .say{ margin-top:10px; font-size:14px; color:var(--ink); background:#F3F6FB; border-left:3px solid var(--amber); border-radius:0 8px 8px 0; padding:12px 16px; font-style:italic; }
  .checklist{ list-style:none; display:grid; gap:10px; margin-top:12px; }
  .checklist li{ position:relative; padding-left:28px; font-size:14px; color:var(--muted); }
  .checklist li::before{ content:'✓'; position:absolute; left:0; top:0; width:20px; height:20px; border-radius:50%; background:var(--strong-bg); color:var(--strong); font-size:12px; font-weight:800; display:flex; align-items:center; justify-content:center; }
  .checklist b{ color:var(--ink); font-weight:600; }


  /* ── Cambio de contenido: Estudiante / Docente ── */
  .js .guia[data-rol="estudiante"] [data-role="docente"]{ display:none !important; }
  .js .guia[data-rol="docente"] [data-role="estudiante"]{ display:none !important; }
  .rol-btn{ border:1px solid var(--card-border); background:#fff; color:var(--navy); }
  .rol-btn[aria-pressed="true"]{ background:var(--navy); color:#fff; border-color:var(--navy); box-shadow:0 4px 16px rgba(26,53,96,0.25); }
  .rol-btn:focus-visible{ outline:2px solid var(--navy); outline-offset:2px; }
  .seg{ flex-shrink:0; display:flex; background:var(--card-bg); border:1px solid var(--card-border); border-radius:20px; padding:3px; margin-right:6px; }
  .seg button{ font-family:inherit; font-size:12.5px; font-weight:700; color:var(--muted); background:none; border:none; border-radius:16px; padding:5px 12px; cursor:pointer; transition:background .2s, color .2s; }
  .seg button[aria-pressed="true"]{ background:var(--navy); color:#fff; }
  .seg button:focus-visible{ outline:2px solid var(--navy); outline-offset:1px; }

  /* ── Si la persona prefiere menos movimiento, se quitan las animaciones ── */
  @@media (prefers-reduced-motion:reduce){
    .js .reveal{ opacity:1; transform:none; transition:none; }
    .level-card .bar i{ transition:none; width:var(--w); }
    .faq-a{ transition:none; }
  }
</style>

<div class="guia" data-rol="estudiante">

<div class="progress" id="progress" aria-hidden="true"></div>

<header class="top">
