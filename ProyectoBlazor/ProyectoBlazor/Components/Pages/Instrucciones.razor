<script>
(function () {
  // Marca la página como "con JavaScript" para activar las animaciones.
  // Sin esto, todo el contenido se ve normal y sin animar.
  document.documentElement.classList.add('js');

  // ── 1) Aparecer al bajar ──
  // Cada elemento .reveal se muestra cuando entra en la pantalla.
  const revelar = new IntersectionObserver((entradas) => {
    entradas.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        revelar.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal, .level-card').forEach((el) => revelar.observe(el));

  // ── 2) Barra de progreso de lectura ──
  const barra = document.getElementById('progress');
  let esperando = false;
  function actualizarBarra() {
    const alto = document.documentElement.scrollHeight - window.innerHeight;
    const p = alto > 0 ? window.scrollY / alto : 0;
    barra.style.transform = 'scaleX(' + Math.min(1, Math.max(0, p)) + ')';
    esperando = false;
  }
  window.addEventListener('scroll', () => {
    if (!esperando) { esperando = true; requestAnimationFrame(actualizarBarra); }
  }, { passive: true });
  actualizarBarra();

  // ── 3) Menú: resalta la sección que estás leyendo ──
  const enlaces = Array.from(document.querySelectorAll('.subnav a'));
  const secciones = enlaces.map((a) => document.querySelector(a.getAttribute('href')));
  const vigilante = new IntersectionObserver((entradas) => {
    entradas.forEach((e) => {
      if (e.isIntersecting) {
        enlaces.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
        const activo = document.querySelector('.subnav a.active');
        if (activo) {
          // Solo mueve el menú horizontal; nunca la página
          const caja = activo.parentElement;
          caja.scrollLeft = activo.offsetLeft - (caja.clientWidth - activo.offsetWidth) / 2;
        }
      }
    });
  }, { rootMargin: '-35% 0px -55% 0px' });
  secciones.forEach((s) => s && vigilante.observe(s));

  // Clic en el menú: desplazamiento suave solo en ese momento
  document.querySelectorAll('.subnav a').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const destino = document.querySelector(a.getAttribute('href'));
      if (!destino) return;
      ev.preventDefault();
      const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: destino.getBoundingClientRect().top + window.scrollY - 60, behavior: reducir ? 'auto' : 'smooth' });
    });
  });

  // ── 4) Preguntas frecuentes (se abren y cierran con animación) ──
  document.querySelectorAll('.faq-item').forEach((item) => {
    const boton = item.querySelector('.faq-q');
    boton.addEventListener('click', () => {
      const abierto = item.classList.toggle('open');
      boton.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
  });
  // ── 5) Cambiar entre guía de Estudiante y guía de Docente ──
  const botonesRol = document.querySelectorAll('[data-set-rol]');
  function setRol(rol, desdeMenu) {
    document.querySelector('.guia').dataset.rol = rol;
    botonesRol.forEach((b) => b.setAttribute('aria-pressed', b.dataset.setRol === rol ? 'true' : 'false'));
    // Reinicia la animación del contenido para que aparezca de nuevo
    document.querySelectorAll('main .reveal, main .level-card').forEach((el) => {
      if (el.closest('#inicio')) return;
      el.classList.remove('visible');
      revelar.observe(el);
    });
    document.querySelectorAll('.faq-item.open').forEach((i) => { i.classList.remove('open'); i.querySelector('.faq-q').setAttribute('aria-expanded','false'); });
    if (desdeMenu && window.scrollY > 0) {
      const ini = document.getElementById(rol === 'docente' ? 'docente' : 'antes');
      window.scrollTo({ top: ini.getBoundingClientRect().top + window.scrollY - 60, behavior: 'auto' });
    }
    try { history.replaceState(null, '', rol === 'docente' ? '#docente' : location.pathname + location.search); } catch (e) {}
  }
  botonesRol.forEach((b) => b.addEventListener('click', () => setRol(b.dataset.setRol, !!b.closest('.seg'))));
  if (/docente/.test(location.hash)) setRol('docente', false);

})();
</script>


