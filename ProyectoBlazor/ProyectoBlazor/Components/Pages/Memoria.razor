@page "/Memoria"
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Memoria</PageTitle>
<!-- ============================================================
     juego Memorama
     ============================================================ -->

<div class="page-scope">
    <!-- Particle background -->
    <div class="particles" id="particles"></div>

    <nav class="game-nav">
        <NavLink href="Estudiante">← Volver a tus pruebas</NavLink>
        <NavLink href="" Match="NavLinkMatch.All">Volver a inicio</NavLink>
    </nav>

    <!-- Header -->
    <header class="header">
        <div class="logo">
            <span class="logo-icon">🧠</span>
            <h1>Memorama <span class="accent">por fases</span></h1>
        </div>
        <p class="subtitle">Evaluación de Memoria</p>
    </header>

    <!-- Game Phase Overlay -->
    <div class="phase-overlay" id="phaseOverlay">
        <div class="phase-content">
            <div class="phase-icon">👀</div>
            <div class="phase-text">
                <h2>¡Memoriza las cartas!</h2>
                <p class="phase-hint">Se voltearán en unos segundos…</p>
            </div>
            <div class="countdown" id="countdown">5</div>
        </div>
    </div>

    <!-- Progreso de la prueba: fase, tablero y errores (siempre visible) -->
    <div class="progress-line" id="progressLine" aria-live="polite">
        <span id="progFase">Fase 1/4</span><span class="sep">·</span>
        <span id="progTablero">Tablero 1/2</span><span class="sep">·</span>
        <span id="progErrores" class="prog-errores">Errores 0/4</span>
    </div>

    <!-- Stats Bar -->
    <div class="stats-bar" id="statsBar">
        <div class="stat-card" id="statTime">
            <div class="stat-icon">⏱️</div>
            <div class="stat-info">
                <span class="stat-label">Tiempo</span>
                <span class="stat-value" id="timerDisplay">00:00</span>
            </div>
        </div>
        <div class="stat-card" id="statMatches">
            <div class="stat-icon">✅</div>
            <div class="stat-info">
                <span class="stat-label">Aciertos</span>
                <span class="stat-value" id="matchesDisplay">0 / 8</span>
            </div>
        </div>
        <div class="stat-card" id="statErrors">
            <div class="stat-icon">❌</div>
            <div class="stat-info">
                <span class="stat-label">Errores</span>
                <span class="stat-value" id="errorsDisplay">0 / 4</span>
            </div>
        </div>
    </div>

    <!-- Game Board -->
    <main class="board-container">
        <div class="board" id="gameBoard"></div>
    </main>

    <!-- Error Pattern Panel -->
    <div class="error-panel" id="errorPanel">
        <div class="error-panel-header">
            <span class="error-panel-icon">📊</span>
            <h3>Patrón de Errores Repetidos</h3>
        </div>
        <div class="error-panel-body" id="errorPanelBody">
            <p class="no-errors">¡Sin errores repetidos aún!</p>
        </div>
    </div>

    <!-- Transición entre tableros / fases -->
    <div class="modal-overlay" id="transitionModal">
        <div class="modal">
            <div class="modal-icon" id="transIcon">✅</div>
            <h2 class="modal-title" id="transTitle">Tablero completado</h2>
            <p class="modal-subtitle" id="transText"></p>
            <button class="btn-play-again" id="btnContinue" type="button">Continuar</button>
        </div>
    </div>

    <!-- Resultados finales (prueba completa o terminada por errores) -->
    <div class="modal-overlay" id="resultModal">
        <div class="modal">
            <div class="modal-icon" id="resIcon">🏆</div>
            <h2 class="modal-title" id="resTitle">Prueba finalizada</h2>
            <p class="modal-subtitle" id="resSubtitle"></p>

            <div class="modal-stats">
                <div class="modal-stat">
                    <span class="modal-stat-icon">🎯</span>
                    <span class="modal-stat-value" id="resPuntaje">0</span>
                    <span class="modal-stat-label">Puntaje</span>
                </div>
                <div class="modal-stat">
                    <span class="modal-stat-icon">⏱️</span>
                    <span class="modal-stat-value" id="resTiempo">00:00</span>
                    <span class="modal-stat-label">Tiempo de juego</span>
                </div>
                <div class="modal-stat">
                    <span class="modal-stat-icon">✅</span>
                    <span class="modal-stat-value" id="resAciertos">0</span>
                    <span class="modal-stat-label">Pares encontrados</span>
                </div>
                <div class="modal-stat">
                    <span class="modal-stat-icon">❌</span>
                    <span class="modal-stat-value" id="resErrores">0</span>
                    <span class="modal-stat-label">Errores</span>
                </div>
            </div>

            <div class="modal-error-summary" id="resFases"></div>

            <NavLink class="btn-play-again" id="btnReturnHome" href="Estudiante" style="text-decoration:none;">
                <span>🏠</span> Regresar al Inicio
            </NavLink>
        </div>
    </div>

    <!-- Start Screen -->
    <div class="start-screen" id="startScreen">
        <div class="cover-wrap">
            <header class="cover-header">
                <div class="header__badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Memoria de trabajo
                </div>
                <h1 class="header__title">Memorama</h1>
                <p class="header__subtitle">Encuentra los pares ocultos en 4 fases de dificultad creciente</p>
            </header>
            <div class="start-card">
                <div class="start-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                </div>
                <h2>¿Listo para el reto?</h2>
                <p>La prueba tiene <strong>4 fases</strong> (tableros de 4×4, 6×6, 8×8 y 10×10) y en cada fase resolverás <strong>2 memoramas</strong> del mismo tamaño. Al inicio de cada tablero se muestran las cartas unos segundos para que las memorices; luego deberás descubrirlas de dos en dos.</p>
                <div class="cover-rules">
                    <div class="cover-rules__item"><span class="cover-rules__num">1</span> 4 fases × 2 tableros: 4×4, 6×6, 8×8 y 10×10</div>
                    <div class="cover-rules__item"><span class="cover-rules__num">2</span> Cada tablero permite un máximo de errores: la mitad de sus pares</div>
                    <div class="cover-rules__item"><span class="cover-rules__num">3</span> Si superas el límite de errores, la prueba termina en ese punto</div>
                </div>
                <button class="btn-primary-cover" id="btnStart">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                    Iniciar Prueba
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("iniciarMemorama");
        }
    }
}
