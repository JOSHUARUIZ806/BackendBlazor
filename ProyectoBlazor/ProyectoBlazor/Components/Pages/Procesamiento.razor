@page "/Procesamiento"
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Procesamiento</PageTitle>
<!-- ============================================================
     juego Conecta los circulos "Test Trazo"                      
     ============================================================ -->
<style>
    /* ── Reset & Variables ── */
    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --bg-deep: #FFFFFF;
        --bg-card: #F6F7F8;
        --border: #ECEDEF;
        --text: #1F2937;
        --text-dim: #6B7280;
        --accent: #1A3560;
        --accent-glow: #24427A;
        --success: #1E9E63;
        --success-glow: #3FB37F;
        --error: #D14343;
        --error-glow: #E27171;
        --gold: #C97B2E;
        --gold-glow: #DB9A54;
        --line-color: rgba(26, 53, 96, 0.55);
        --radius: 14px;
        --circle-r: 25px;
        --font: 'Inter', system-ui, sans-serif;
        --mono: 'JetBrains Mono', monospace;
    }

    html {
        height: 100%;
    }

    body {
        font-family: var(--font);
        background: var(--bg-deep);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        overflow: hidden;
        user-select: none;
        -webkit-user-select: none;
    }

        /* ── Header ── */
        body > header {
            width: 100%;
            padding: 58px 28px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            z-index: 10;
            flex-shrink: 0;
        }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .brand-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--accent), #24427A);
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-weight: 900;
        font-size: 16px;
        color: #fff;
        box-shadow: 0 0 20px rgba(26, 53, 96, 0.3);
    }

    .brand h1 {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.3px;
        background: linear-gradient(135deg, #1A3560, #24427A);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* ── Stats Bar ── */
    .stats {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .stat-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 100px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        font-size: 13px;
        font-weight: 500;
        backdrop-filter: blur(8px);
        transition: border-color 0.3s, box-shadow 0.3s, transform 0.2s;
    }

        .stat-chip .label {
            color: var(--text-dim);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-chip .value {
            font-family: var(--mono);
            font-weight: 700;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .stat-chip.level .value {
            color: var(--accent);
            font-size: 13px;
        }

        .stat-chip.target {
            border-color: rgba(26, 53, 96, 0.35);
            background: rgba(26, 53, 96, 0.06);
        }

            .stat-chip.target .value {
                color: var(--accent);
                font-size: 14px;
            }

        .stat-chip.hits .value {
            color: var(--success);
        }

        .stat-chip.errors .value {
            color: var(--error);
        }

        .stat-chip.time .value {
            color: var(--gold);
        }

        .stat-chip.hits.pulse {
            border-color: var(--success);
            box-shadow: 0 0 12px rgba(30, 158, 99, 0.3);
        }

        .stat-chip.errors.pulse {
            border-color: var(--error);
            box-shadow: 0 0 12px rgba(209, 67, 67, 0.3);
        }

        .stat-chip.target.pulse {
            border-color: var(--accent);
            box-shadow: 0 0 14px rgba(26, 53, 96, 0.35);
            transform: scale(1.05);
        }

    /* ── Banner flotante de objetivo dentro del área de juego (Fases 2 y 3) ── */
    .target-prompt {
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 6;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 20px;
        border-radius: 100px;
        background: rgba(255, 255, 255, 0.94);
        border: 2px solid var(--accent);
        box-shadow: 0 6px 24px rgba(26, 53, 96, 0.16);
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        pointer-events: none;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
    }

        .target-prompt[hidden] {
            display: none;
        }

        .target-prompt.pulse {
            transform: translateX(-50%) scale(1.08);
            box-shadow: 0 8px 28px rgba(26, 53, 96, 0.28);
        }

    .target-prompt__label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--text-dim);
    }

    .target-prompt__value {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--mono);
        font-size: 16px;
        font-weight: 800;
        color: var(--accent);
    }

        .target-prompt__value svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

    /* ── Play Area ── */
    .play-area-wrapper {
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        position: relative;
    }

    .play-area {
        position: relative;
        width: min(900px, 100%);
        aspect-ratio: 16 / 10;
        max-height: calc(100vh - 140px);
        background: radial-gradient(ellipse at 30% 20%, rgba(26, 53, 96, 0.04) 0%, transparent 60%), radial-gradient(ellipse at 70% 80%, rgba(201, 123, 46, 0.03) 0%, transparent 60%), var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 0 0 1px rgba(19, 40, 72, 0.02), 0 8px 40px rgba(19, 40, 72, 0.08);
    }

        /* Grid pattern */
        .play-area::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(19, 40, 72, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(19, 40, 72, 0.035) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

    /* ── SVG Lines ── */
    #lineCanvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

        #lineCanvas line {
            stroke: var(--line-color);
            stroke-width: 2.5;
            stroke-linecap: round;
            filter: drop-shadow(0 0 4px rgba(26, 53, 96, 0.35));
        }

    .line-animate {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: drawLine 0.4s ease-out forwards;
    }

    @@keyframes drawLine {
        to {
            stroke-dashoffset: 0;
        }
    }

    /* ── Circles & Geometric Nodes ── */
    .circle {
        position: absolute;
        width: calc(var(--circle-r) * 2);
        height: calc(var(--circle-r) * 2);
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-family: var(--mono);
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        z-index: 2;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
        transform: translate(-50%, -50%) scale(0);
        will-change: transform;
        background: #F6F7F8;
        border: 2px solid rgba(26, 53, 96, 0.3);
        color: #1A3560;
        box-shadow: 0 0 12px rgba(26, 53, 96, 0.1), inset 0 1px 0 rgba(19, 40, 72, 0.03);
        backdrop-filter: blur(6px);
    }

        /* Nodos de Fase 2 (figuras geométricas puras con la misma estética) */
        .circle.shape-node {
            background: transparent;
            border: none;
            box-shadow: none;
            backdrop-filter: none;
        }

            .circle.shape-node svg {
                width: 100%;
                height: 100%;
                overflow: visible;
                filter: drop-shadow(0 0 10px rgba(26, 53, 96, 0.12));
                transition: filter 0.2s;
            }

            .circle.shape-node .shape-svg-path {
                fill: #F6F7F8;
                stroke: rgba(26, 53, 96, 0.38);
                stroke-width: 2.2;
                stroke-linejoin: round;
                transition: fill 0.2s, stroke 0.2s;
            }

        .circle.visible {
            transform: translate(-50%, -50%) scale(1);
        }

        .circle.first-visible {
            border-color: var(--accent-glow);
            background: rgba(26, 53, 96, 0.12);
            color: var(--accent);
            box-shadow: 0 0 20px rgba(26, 53, 96, 0.3), 0 0 40px rgba(26, 53, 96, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.4);
            animation: pulseFirst 2s ease-in-out infinite;
        }

    @@keyframes pulseFirst {

        0%,
        100% {
            box-shadow: 0 0 20px rgba(26, 53, 96, 0.3), 0 0 40px rgba(26, 53, 96, 0.12);
        }

        50% {
            box-shadow: 0 0 28px rgba(26, 53, 96, 0.45), 0 0 56px rgba(26, 53, 96, 0.2);
        }
    }

    .circle:hover:not(.done):not(.error-flash) {
        transform: translate(-50%, -50%) scale(1.12);
        box-shadow: 0 0 20px rgba(26, 53, 96, 0.3);
    }

    .circle.shape-node:hover:not(.done):not(.error-flash) {
        box-shadow: none;
    }

        .circle.shape-node:hover:not(.done):not(.error-flash) svg {
            filter: drop-shadow(0 0 16px rgba(26, 53, 96, 0.32));
        }

        .circle.shape-node:hover:not(.done):not(.error-flash) .shape-svg-path {
            stroke: var(--accent);
        }

    .circle.done {
        background: rgba(30, 158, 99, 0.16);
        border-color: var(--success);
        color: var(--success);
        cursor: default;
        box-shadow: 0 0 14px rgba(30, 158, 99, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.4);
        animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .circle.shape-node.done {
        background: transparent;
        box-shadow: none;
    }

        .circle.shape-node.done svg {
            filter: drop-shadow(0 0 12px rgba(30, 158, 99, 0.28));
        }

        .circle.shape-node.done .shape-svg-path {
            fill: rgba(30, 158, 99, 0.18);
            stroke: var(--success);
        }

    @@keyframes popIn {
        0% {
            transform: translate(-50%, -50%) scale(0.6);
        }

        50% {
            transform: translate(-50%, -50%) scale(1.15);
        }

        100% {
            transform: translate(-50%, -50%) scale(1);
        }
    }

    .circle.error-flash {
        animation: errorShake 0.5s ease;
        border-color: var(--error);
        background: rgba(209, 67, 67, 0.16);
        color: var(--error);
        box-shadow: 0 0 20px rgba(209, 67, 67, 0.3);
    }

    .circle.shape-node.error-flash {
        background: transparent;
        box-shadow: none;
    }

        .circle.shape-node.error-flash svg {
            filter: drop-shadow(0 0 16px rgba(209, 67, 67, 0.35));
        }

        .circle.shape-node.error-flash .shape-svg-path {
            fill: rgba(209, 67, 67, 0.18);
            stroke: var(--error);
        }

    @@keyframes errorShake {

        0%,
        100% {
            transform: translate(-50%, -50%) scale(1) translateX(0);
        }

        20% {
            transform: translate(-50%, -50%) scale(1) translateX(-6px);
        }

        40% {
            transform: translate(-50%, -50%) scale(1) translateX(6px);
        }

        60% {
            transform: translate(-50%, -50%) scale(1) translateX(-4px);
        }

        80% {
            transform: translate(-50%, -50%) scale(1) translateX(4px);
        }
    }

    /* ── Overlays ── */
    .overlay {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: rgba(19, 40, 72, 0.78);
        backdrop-filter: blur(10px);
        z-index: 20;
        opacity: 1;
        transition: opacity 0.4s;
    }

        .overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .overlay-card {
        text-align: center;
        padding: 40px 48px;
        background: #FFFFFF;
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 16px 64px rgba(19, 40, 72, 0.25);
        max-width: 420px;
        width: 90%;
        max-height: 96%;
        overflow-y: auto;
    }

        .overlay-card h2 {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
            background: linear-gradient(135deg, #1F2937, var(--accent-glow));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .overlay-card .subtitle {
            color: var(--text-dim);
            font-size: 14px;
            margin-bottom: 28px;
            line-height: 1.5;
        }

        .overlay-card .results {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 24px;
        }

    .result-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        background: #F6F7F8;
        border-radius: 10px;
        border: 1px solid var(--border);
    }

        .result-row .r-label {
            font-size: 13px;
            color: var(--text-dim);
        }

        .result-row .r-value {
            font-family: var(--mono);
            white-space: nowrap;
            margin-left: 12px;
            font-weight: 700;
            font-size: 16px;
        }

            .result-row .r-value.green {
                color: var(--success);
            }

            .result-row .r-value.red {
                color: var(--error);
            }

            .result-row .r-value.yellow {
                color: var(--gold);
            }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 32px;
        border: none;
        border-radius: 12px;
        font-family: var(--font);
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        color: #fff;
        background: linear-gradient(135deg, var(--accent), #24427A);
        box-shadow: 0 4px 20px rgba(26, 53, 96, 0.3);
    }

        .btn[hidden] {
            display: none;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 28px rgba(26, 53, 96, 0.4);
        }

        .btn:active {
            transform: translateY(0);
        }

    /* ── Progress Bar ── */
    .progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--accent), var(--success-glow));
        border-radius: 0 3px 0 0;
        transition: width 0.35s ease-out;
        z-index: 5;
        box-shadow: 0 0 8px rgba(26, 53, 96, 0.35);
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        body > header {
            padding: 96px 14px 12px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .brand h1 {
            font-size: 15px;
        }

        .stats {
            gap: 4px;
        }

        .stat-chip {
            padding: 4px 10px;
            font-size: 11px;
        }

            .stat-chip .value {
                font-size: 12px;
            }
        /* En celular el área es más alta que ancha para que quepan los elementos */
        .play-area {
            border-radius: 10px;
            aspect-ratio: 3 / 4;
        }

        .overlay-card {
            padding: 28px 24px;
        }

            .overlay-card h2 {
                font-size: 22px;
            }

        :root {
            --circle-r: 21px;
        }

        .circle {
            font-size: 13px;
        }

        .target-prompt {
            padding: 6px 14px;
            font-size: 12px;
            top: 8px;
        }

        .target-prompt__value {
            font-size: 14px;
        }
    }

    /* ── Start Screen ── */
    .start-screen {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-deep);
        overflow-y: auto;
        transition: opacity 0.35s ease, visibility 0.35s ease;
    }

        .start-screen.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

    /* ── Confetti Canvas ── */
    #confetti {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 100;
    }
</style>

  <nav class="game-nav">
    <NavLink href="Estudiante">← Volver a tus pruebas</NavLink>
    <NavLink href="" Match="NavLinkMatch.All">Volver a inicio</NavLink>
  </nav>

  <!-- Header -->
  <header>
    <div class="brand">
      <div class="brand-icon">3</div>
      <h1>Conecta los Círculos</h1>
    </div>
    <div class="stats">
      <div class="stat-chip level" id="statLevel">
        <span class="label">Fase</span>
        <span class="value" id="levelVal"></span>
      </div>
      <div class="stat-chip target" id="statTarget" hidden>
        <span class="label">Objetivo</span>
        <span class="value" id="targetVal"></span>
      </div>
      <div class="stat-chip hits" id="statHits">
        <span class="label">Aciertos</span>
        <span class="value" id="hitsVal">0</span>
      </div>
      <div class="stat-chip errors" id="statErrors">
        <span class="label">Errores</span>
        <span class="value" id="errorsVal">0</span>
      </div>
      <div class="stat-chip time">
        <span class="label">Tiempo</span>
        <span class="value" id="timerVal">00:00.0</span>
      </div>
    </div>
  </header>

  <!-- Play Area -->
  <div class="play-area-wrapper">
    <div class="play-area" id="playArea">
      <!-- Indicador dinámico en pantalla para Fases 2 y 3 -->
      <div class="target-prompt" id="targetPrompt" hidden>
        <span class="target-prompt__label" id="targetPromptLabel">Conecta:</span>
        <span class="target-prompt__value" id="targetPromptValue"></span>
      </div>

      <svg id="lineCanvas"></svg>
      <div class="progress-bar" id="progressBar"></div>

      <!-- End Overlay -->
      <div class="overlay hidden" id="endOverlay">
        <div class="overlay-card">
          <h2 id="endTitle"></h2>
          <div class="results" id="results"></div>
          <button class="btn" id="btnNext" type="button" hidden>Siguiente fase&ensp;→</button>
          <NavLink class="btn" id="btnReturnHome" href="Estudiante" style="text-decoration:none;"
            hidden>🏠&ensp;Regresar al Inicio</NavLink>
        </div>
      </div>
    </div>
  </div>

  <!-- Start Overlay -->
  <div class="start-screen" id="startOverlay">
    <div class="cover-wrap">
      <header class="cover-header">
        <div class="header__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M13 2 3 14h6l-1 8 10-12h-6z" />
          </svg>
          Velocidad de procesamiento
        </div>
        <h1 class="header__title">Conecta los Círculos</h1>
        <p class="header__subtitle">Tres fases: números en orden, figuras geométricas y combinación de números y letras
        </p>
      </header>
      <div class="start-card">
        <div class="start-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
        </div>
        <h2>¿Listo para el reto?</h2>
        <p>Recorrerás 3 fases consecutivas lo más rápido posible. Además de tu rapidez y tus errores, se mide cuánto
          tardas en dar el primer clic en cuanto aparecen los elementos.</p>
        <div class="cover-rules">
          <div class="cover-rules__item"><span class="cover-rules__num">1</span> <strong>Fase 1 (Números):</strong>
            Conecta los círculos del 1 al 25 en orden ascendente.</div>
          <div class="cover-rules__item"><span class="cover-rules__num">2</span> <strong>Fase 2 (Figuras):</strong> 30
            figuras (10 cuadrados, 10 triángulos y 10 círculos). En cada paso el sistema te indicará al azar qué figura
            conectar.</div>
          <div class="cover-rules__item"><span class="cover-rules__num">3</span> <strong>Fase 3 (Números y
              Letras):</strong> 15 números y 15 letras. Tras cada selección, el sistema te mostrará en pantalla qué
            número o letra debes elegir a continuación.</div>
        </div>
        <button class="btn-primary-cover" id="btnStart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
            stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
          Iniciar Prueba
        </button>
      </div>
    </div>
  </div>

  <!-- Confetti -->
  <canvas id="confetti"></canvas>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("iniciarProcesamiento");
        }
    }
}
