@page "/Procesamiento"
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Procesamiento</PageTitle>
<!-- ============================================================
     juego Conecta los circulos "Test Trazo"                      
     ============================================================ -->

<div class="page-scope">
  <nav class="game-nav">
    <NavLink href="Estudiante">← Volver a tus pruebas</NavLink>
    <NavLink href="" Match="NavLinkMatch.All">Volver a inicio</NavLink>
  </nav>

  <!-- Header -->
  <header>
    <div class="brand">
      <div class="brand-icon">3</div>
      <h1>Conecta los Círculos</h1>
    </div>
    <div class="stats">
      <div class="stat-chip level" id="statLevel">
        <span class="label">Fase</span>
        <span class="value" id="levelVal"></span>
      </div>
      <div class="stat-chip target" id="statTarget" hidden>
        <span class="label">Objetivo</span>
        <span class="value" id="targetVal"></span>
      </div>
      <div class="stat-chip hits" id="statHits">
        <span class="label">Aciertos</span>
        <span class="value" id="hitsVal">0</span>
      </div>
      <div class="stat-chip errors" id="statErrors">
        <span class="label">Errores</span>
        <span class="value" id="errorsVal">0</span>
      </div>
      <div class="stat-chip time">
        <span class="label">Tiempo</span>
        <span class="value" id="timerVal">00:00.0</span>
      </div>
    </div>
  </header>

  <!-- Play Area -->
  <div class="play-area-wrapper">
    <div class="play-area" id="playArea">
      <!-- Indicador dinámico en pantalla para Fases 2 y 3 -->
      <div class="target-prompt" id="targetPrompt" hidden>
        <span class="target-prompt__label" id="targetPromptLabel">Conecta:</span>
        <span class="target-prompt__value" id="targetPromptValue"></span>
      </div>

      <svg id="lineCanvas"></svg>
      <div class="progress-bar" id="progressBar"></div>

      <!-- End Overlay -->
      <div class="overlay hidden" id="endOverlay">
        <div class="overlay-card">
          <h2 id="endTitle"></h2>
          <div class="results" id="results"></div>
          <button class="btn" id="btnNext" type="button" hidden>Siguiente fase&ensp;→</button>
          <NavLink class="btn" id="btnReturnHome" href="Estudiante" style="text-decoration:none;"
            hidden>🏠&ensp;Regresar al Inicio</NavLink>
        </div>
      </div>
    </div>
  </div>

  <!-- Start Overlay -->
  <div class="start-screen" id="startOverlay">
    <div class="cover-wrap">
      <header class="cover-header">
        <div class="header__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M13 2 3 14h6l-1 8 10-12h-6z" />
          </svg>
          Velocidad de procesamiento
        </div>
        <h1 class="header__title">Conecta los Círculos</h1>
        <p class="header__subtitle">Tres fases: números en orden, figuras geométricas y combinación de números y letras
        </p>
      </header>
      <div class="start-card">
        <div class="start-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
        </div>
        <h2>¿Listo para el reto?</h2>
        <p>Recorrerás 3 fases consecutivas lo más rápido posible. Además de tu rapidez y tus errores, se mide cuánto
          tardas en dar el primer clic en cuanto aparecen los elementos.</p>
        <div class="cover-rules">
          <div class="cover-rules__item"><span class="cover-rules__num">1</span> <strong>Fase 1 (Números):</strong>
            Conecta los círculos del 1 al 25 en orden ascendente.</div>
          <div class="cover-rules__item"><span class="cover-rules__num">2</span> <strong>Fase 2 (Figuras):</strong> 30
            figuras (10 cuadrados, 10 triángulos y 10 círculos). En cada paso el sistema te indicará al azar qué figura
            conectar.</div>
          <div class="cover-rules__item"><span class="cover-rules__num">3</span> <strong>Fase 3 (Números y
              Letras):</strong> 15 números y 15 letras. Tras cada selección, el sistema te mostrará en pantalla qué
            número o letra debes elegir a continuación.</div>
        </div>
        <button class="btn-primary-cover" id="btnStart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
            stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
          Iniciar Prueba
        </button>
      </div>
    </div>
  </div>

  <!-- Confetti -->
  <canvas id="confetti"></canvas>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("iniciarProcesamiento");
        }
    }
}
